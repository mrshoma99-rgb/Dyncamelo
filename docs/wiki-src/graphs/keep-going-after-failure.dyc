  "Notes": [
    {
      "Id": "fa62116a6c69b55ac98b409a06063230",
      "Text": "WHAT IT DOES: Flow.Try catches a failure of the node before it, so nothing after it turns red; Flow.When lets the logging run only when it did fail, and Log.Write adds the error text to the log file. TO CHANGE: put any risky node where the worksheet reader is, and set the log path.",
      "X": 0.0,
      "Y": -180.0
    }
