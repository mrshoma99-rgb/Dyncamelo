{
  "name": "Large items to Excel",
  "description": "A script made for the Script Player: its Number, Choice and File Path nodes become the form and the table it writes is shown as the result.",
  "run": "Manual",
  "nodes": [
    {"id": "limit", "node": "Number", "title": "Volume limit", "value": 2},
    {"id": "test", "node": "Choice", "title": "Volume is", "options": [">", ">=", "<", "<="], "value": ">"},
    {"id": "file", "node": "File Path", "title": "Save the list as", "value": "C:\\Reports\\large-items.xlsx"},
    {"id": "search", "node": "Search.ByProperty", "values": {"categoryName": "Element", "propertyName": "Volume"}},
    {"id": "columns", "node": "String", "title": "Columns to read", "value": "@Name,Element.Category,Element.Volume"},
    {"id": "split", "node": "String.Split", "title": "Split columns", "values": {"separator": ","}},
    {"id": "table", "node": "Properties.ToTable"},
    {"id": "excel", "node": "Table.ToExcelFile", "values": {"sheet": "Large items"}},
    {"id": "show", "node": "Watch Table", "title": "Items found"}
  ],
  "wires": [
    "test.value -> search.mode",
    "limit.value -> search.value",
    "columns.value -> split.text",
    "search.items -> table.items",
    "split.list -> table.properties",
    "table.table -> excel.table",
    "file.path -> excel.path",
    "table.table -> show.table"
  ],
  "notes": [
    {"text": "WHAT IT DOES: lists the items whose Element > Volume passes the test you pick and saves the list to Excel. In the Script Player the Number, Choice and File Path nodes are the form and the Watch Table is the result. TO CHANGE: the property searched on Search.ByProperty and the columns to read."}
  ]
}
