{
  "name": "Takeoff form",
  "description": "A script made for the Script Player: a number, a choice and a file path become the form, and the totals are written to Excel.",
  "run": "Manual",
  "nodes": [
    {"id": "limit", "node": "Number", "title": "Minimum volume", "value": 1},
    {"id": "group", "node": "Choice", "title": "Group by", "options": ["Element.Category", "Element.Level"], "value": "Element.Category"},
    {"id": "file", "node": "File Path", "title": "Excel file", "value": "C:\\Temp\\takeoff.xlsx"},
    {"id": "search", "node": "Search.ByProperty", "values": {"categoryName": "Element", "propertyName": "Volume", "mode": ">"}},
    {"id": "columns", "node": "String.Split", "title": "Split columns",
     "values": {"text": "Element.Category,Element.Level,Element.Volume", "separator": ","}},
    {"id": "table", "node": "Properties.ToTable"},
    {"id": "totals", "node": "String.Split", "title": "Split totals", "values": {"text": "count,sum:Element.Volume", "separator": ","}},
    {"id": "grouped", "node": "Table.GroupBy"},
    {"id": "excel", "node": "Table.ToExcelFile"},
    {"id": "show", "node": "Watch Table", "title": "Totals"}
  ],
  "wires": [
    "limit.value -> search.value",
    "search.items -> table.items",
    "columns.list -> table.properties",
    "table.table -> grouped.table",
    "group.value -> grouped.by",
    "totals.list -> grouped.aggregations",
    "grouped.table -> excel.table",
    "file.path -> excel.path",
    "grouped.table -> show.table"
  ],
  "notes": [
    {"text": "WHAT IT DOES: finds the items whose Element > Volume is above the minimum, totals them by the property you choose and writes the totals to Excel. In the Script Player the Number, Choice and File Path nodes become the form and the Watch Table is the result. TO CHANGE: the property searched on Search.ByProperty and the columns to read."}
  ]
}
