  "Notes": [
    {
      "Id": "90000000000000000000000000000000",
      "Text": "WHOLE-PROJECT CLASH GROUP VIEWPOINTS\nClash.AllGroups gathers every result group of every clash test as one flat list, so a single loop covers the whole project (nested loops are not supported). Each iteration: ClashGroup.Info hands out that group's results, its name and its test's name.",
      "X": -430,
      "Y": -230,
      "Width": 430,
      "Height": 110
    },
    {
      "Id": "90000000000000000000000000000001",
      "Text": "PER GROUP: isolate + zoom the whole group (ClashResult.Focus), colour side 1 of every clash red and side 2 green as TEMPORARY overrides, then save. Viewpoint.SaveWithOverrides bakes the isolate and the colours into the view and files it in a folder named after the test \u2014 creating that folder if it does not exist.",
      "X": 330,
      "Y": -300,
      "Width": 620,
      "Height": 120
    },
    {
      "Id": "90000000000000000000000000000002",
      "Text": "ORDERING: the Flow.Then chain is what forces isolate -> zoom -> red -> green -> save inside each iteration. Without it those side effects would run in an undefined order and every viewpoint would capture the same camera. Colours stay on the live model afterwards; run Appearance.ResetTemporary and Appearance.ShowAll to clear the session (the saved views keep their own frozen state).",
      "X": 1010,
      "Y": 330,
      "Width": 620,
      "Height": 130
    }
  ],
  "Groups": [],
  "View": {
    "RunType": "Manual",
    "Camera": {
      "X": 0.0,
      "Y": 0.0,
      "Zoom": 1.0
    }
  }
}