<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A process of its own for the "editor hosted the way Navisworks hosts it" test: a WinForms ElementHost on a form, no WPF
    Application, a plain STA thread. Run by CamelGraph.UI.Tests as a child process, so whatever WPF leaves behind at exit can
    neither hang nor kill the test host.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CamelGraph.UI.HostProbe</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- WPF/net48 cannot build on non-Windows agents; CI builds and runs this on windows-latest. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CamelGraph.Core\CamelGraph.Core.csproj" />
    <ProjectReference Include="..\..\src\CamelGraph.UI\CamelGraph.UI.csproj" />
    <ProjectReference Include="..\..\src\CamelGraph.Nodes\CamelGraph.Nodes.csproj" />
  </ItemGroup>

</Project>
