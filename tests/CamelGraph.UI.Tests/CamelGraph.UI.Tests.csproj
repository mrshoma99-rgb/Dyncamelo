<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CamelGraph.UI.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- WPF/net48 cannot build on non-Windows agents; CI builds and runs this on windows-latest. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Shared test support: the Navisworks node stand-ins (built from docs/camelgraph-nodes.json), compiled into both test projects. -->
    <Compile Include="..\Shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CamelGraph.Core\CamelGraph.Core.csproj" />
    <ProjectReference Include="..\..\src\CamelGraph.UI\CamelGraph.UI.csproj" />
    <ProjectReference Include="..\..\src\CamelGraph.Nodes\CamelGraph.Nodes.csproj" />
    <!-- The editor hosted the way Navisworks hosts it runs in a process of its own (HostedLikeNavisworksTests); the exe is copied next to the tests. -->
    <ProjectReference Include="..\CamelGraph.UI.HostProbe\CamelGraph.UI.HostProbe.csproj" />
  </ItemGroup>

</Project>
