<UserControl x:Class="CamelGraph.UI.Views.PlayerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodify="https://miroiu.github.io/nodify"
             xmlns:vm="clr-namespace:CamelGraph.UI.ViewModels"
             xmlns:views="clr-namespace:CamelGraph.UI.Views"
             MinWidth="300"
             MinHeight="280">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CamelGraph.UI;component/Themes/CamelGraphDark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/CamelGraph.UI;component/Themes/Logo.xaml" />
                <ResourceDictionary Source="pack://application:,,,/CamelGraph.UI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <CollectionViewSource x:Key="ScriptsView" Source="{Binding Scripts}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Folder" />
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>

            <!-- The card that names the open script and unfolds the list of scripts. -->
            <Style x:Key="Player.PickerButton" TargetType="{x:Type Button}">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
                <Setter Property="Background" Value="{DynamicResource Dyc.NodeBodyBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Dyc.PanelBorderBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsListOpen}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- The header button that unfolds the script folders: lit while they are shown. -->
            <Style x:Key="Player.FoldersButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Dyc.Panel.IconButton}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFoldersOpen}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource Dyc.AccentBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- A read-only box for the text a script produced: keeps its columns (no wrapping), scrolls both ways, never cuts text off. -->
            <Style x:Key="Player.OutputBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource Dyc.TextBox}">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="MaxHeight" Value="240" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="8,6" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel x:Name="LayoutRoot" Background="{DynamicResource Dyc.PanelBrush}">

        <!-- ===== Header: the Player mark, the name of the pane, and the button that shows the script folders ===== -->
        <Border x:Name="PlayerHeader"
                DockPanel.Dock="Top"
                Height="52"
                BorderBrush="{DynamicResource Dyc.PanelBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Dyc.Panel.IconWell}" VerticalAlignment="Center">
                    <!-- the mark follows the palette: triangle in the text colour, wire in the accent, and the gap where one wire passes
                         under the other in the colour of the well -->
                    <ContentControl Template="{StaticResource Dyc.Logo.PlayerSmall}"
                                    Width="22" Height="22"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Focusable="False" IsTabStop="False"
                                    Foreground="{DynamicResource Dyc.TextBrush}"
                                    BorderBrush="{DynamicResource Dyc.AccentBrush}"
                                    Background="{DynamicResource Dyc.HoverBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock Text="Script Player"
                               FontSize="15"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Dyc.TextBrush}" />
                    <TextBlock Text="runs a script without the node editor"
                               FontSize="11.5"
                               Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                </StackPanel>
                <Button Grid.Column="2"
                        Style="{StaticResource Player.FoldersButton}"
                        ToolTip="Script folders"
                        AutomationProperties.Name="Script folders"
                        Command="{Binding ToggleFoldersCommand}">
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          Data="{StaticResource Dyc.Icon.Open}" />
                </Button>
            </Grid>
        </Border>

        <!-- ===== Footer: always in reach, however long the form is. A note when there is something to say (the status line, the progress
             of a run), then Run with the buttons that go with it. It is gone when none of them applies. ===== -->
        <Border x:Name="PlayerFooter"
                DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource Dyc.PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,10,12,12">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasScript}" Value="False" />
                                <Condition Binding="{Binding HasStatus}" Value="False" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <Border Style="{StaticResource Dyc.Panel.Banner}"
                        Margin="0,0,0,10"
                        Visibility="{Binding HasStatus, Converter={StaticResource Dyc.BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Top"
                              Margin="0,1,8,0"
                              Fill="{DynamicResource Dyc.AccentBrush}"
                              Data="{StaticResource Dyc.Icon.FnInfo}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   TextWrapping="Wrap"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Dyc.TextBrush}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Dyc.Panel.Banner}"
                        Margin="0,0,0,10"
                        Visibility="{Binding IsRunning, Converter={StaticResource Dyc.BoolToVisibility}}">
                    <TextBlock Text="{Binding RunProgressText}"
                               TextWrapping="Wrap"
                               FontSize="11.5"
                               Foreground="{DynamicResource Dyc.AccentBrush}" />
                </Border>
                <Grid Visibility="{Binding HasScript, Converter={StaticResource Dyc.BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RunButton"
                            Style="{StaticResource Dyc.Panel.PrimaryButton}"
                            ToolTip="Run the script with the values above"
                            AutomationProperties.Name="Run"
                            Command="{Binding RunCommand}">
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  Data="{StaticResource Dyc.Icon.Run}" />
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Title, StringFormat='Run {0}'}" />
                        </Grid>
                    </Button>
                    <Button Grid.Column="1"
                            Style="{StaticResource Dyc.Panel.GhostIconButton}"
                            Margin="8,0,0,0"
                            ToolTip="Put every field back to the value saved in the script"
                            AutomationProperties.Name="Reset"
                            Command="{Binding ResetCommand}">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              Data="{StaticResource Dyc.Icon.Undo}" />
                    </Button>
                    <Button Grid.Column="2"
                            Style="{StaticResource Dyc.Panel.GhostIconButton}"
                            Margin="8,0,0,0"
                            ToolTip="Open this script in the node editor"
                            AutomationProperties.Name="Edit"
                            Command="{Binding OpenInEditorCommand}">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              Data="{StaticResource Dyc.Icon.OpenGroup}" />
                    </Button>
                    <Button Grid.Column="3"
                            Style="{StaticResource Dyc.Panel.GhostIconButton}"
                            Margin="8,0,0,0"
                            ToolTip="Show the file in Explorer"
                            AutomationProperties.Name="File"
                            Command="{Binding ShowInExplorerCommand}">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              Data="{StaticResource Dyc.Icon.Cat.File}" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== The script card and the list it unfolds ===== -->
        <StackPanel DockPanel.Dock="Top" Margin="12,12,12,0">
            <!-- Where scripts come from: shown by the folder button in the header. -->
            <Border x:Name="FoldersCard"
                    Style="{StaticResource Dyc.Panel.Section}"
                    Margin="0,0,0,10"
                    Visibility="{Binding IsFoldersOpen, Converter={StaticResource Dyc.BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Dyc.Panel.Eyebrow}" Text="SCRIPT FOLDERS" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Folders}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource Dyc.Panel.GhostButton}"
                                            Content="✕"
                                            MinHeight="26"
                                            Padding="8,0"
                                            FontSize="11"
                                            ToolTip="Take this folder off the list (the files stay)"
                                            Command="{Binding RemoveCommand}"
                                            Visibility="{Binding CanRemove, Converter={StaticResource Dyc.BoolToVisibility}}" />
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource Dyc.Panel.GhostButton}"
                                            Content="Open"
                                            MinHeight="26"
                                            Padding="10,0"
                                            FontSize="11"
                                            Margin="0,0,6,0"
                                            ToolTip="Show the folder in Explorer"
                                            Command="{Binding OpenCommand}" />
                                    <TextBlock Text="{Binding Path}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="11.5"
                                               ToolTip="{Binding Path}"
                                               Foreground="{DynamicResource Dyc.TextBrush}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource Dyc.Panel.GhostButton}"
                            Content="Add a folder…"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            Command="{Binding AddFolderCommand}" />
                </StackPanel>
            </Border>

            <Button Style="{StaticResource Player.PickerButton}"
                    Command="{Binding ToggleListCommand}"
                    ToolTip="Choose a script">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Dyc.Panel.IconWell}">
                        <Path Width="15" Height="15" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{DynamicResource Dyc.AccentBrush}"
                              Data="{StaticResource Dyc.Icon.Cat.File}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PickerTitle}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Dyc.TextBrush}" />
                        <TextBlock Text="{Binding PickerSubtitle}"
                                   FontSize="10.5"
                                   Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                    </StackPanel>
                    <Path Grid.Column="2"
                          Width="12" Height="7"
                          VerticalAlignment="Center"
                          Data="M1,1 L6,6 L11,1"
                          Stroke="{DynamicResource Dyc.SubtleTextBrush}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.Style>
                            <Style TargetType="{x:Type Path}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsListOpen}" Value="True">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="180" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <!-- What the script is for, as its author wrote it (the full text is in the tooltip). -->
                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="3"
                               Text="{Binding Description}"
                               Margin="0,10,0,0"
                               FontSize="11.5"
                               MaxHeight="64"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Description}"
                               Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                               Visibility="{Binding HasDescription, Converter={StaticResource Dyc.BoolToVisibility}}" />
                </Grid>
            </Button>

            <Border Style="{StaticResource Dyc.Panel.Section}"
                    Margin="0,8,0,0"
                    Padding="8"
                    Visibility="{Binding IsListOpen, Converter={StaticResource Dyc.BoolToVisibility}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource Dyc.Panel.IconButton}"
                                Width="34" Height="34"
                                Margin="8,0,0,0"
                                ToolTip="Look for scripts again"
                                AutomationProperties.Name="Look for scripts again"
                                Command="{Binding RefreshCommand}">
                            <TextBlock Text="↻" FontSize="15" />
                        </Button>
                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource Dyc.Panel.SearchBox}"
                                     Height="34"
                                     FontSize="12.5"
                                     Padding="34,0,10,0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Filter the scripts by name or folder. Down moves into the list, Enter chooses."
                                     PreviewKeyDown="OnSearchBoxKeyDown" />
                            <Path Width="13" Height="13" Stretch="Uniform"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Margin="12,0,0,0"
                                  IsHitTestVisible="False"
                                  Fill="{DynamicResource Dyc.SubtleTextBrush}"
                                  Data="{StaticResource Dyc.Icon.Search}" />
                            <TextBlock Text="Search scripts"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="35,0,0,0"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource Dyc.SubtleTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>

                    <TextBlock Text="{Binding EmptyListText}"
                               Margin="4,6"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                               Visibility="{Binding IsListEmpty, Converter={StaticResource Dyc.BoolToVisibility}}" />

                    <ListBox x:Name="ScriptList"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="300"
                             Foreground="{DynamicResource Dyc.TextBrush}"
                             ItemsSource="{Binding Source={StaticResource ScriptsView}}"
                             SelectedItem="{Binding SelectedScript, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewKeyDown="OnScriptListKeyDown"
                             PreviewMouseLeftButtonUp="OnScriptListMouseUp">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   Margin="4,8,0,3"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="Chrome"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="2,0,0,0"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- ===== The selected script ===== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,12,12,14">

                <TextBlock Text="Choose a script above to see what it asks for, then press Run."
                           Margin="4,18,4,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Dyc.SubtleTextBrush}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasScript}" Value="False" />
                                        <Condition Binding="{Binding HasLoadError}" Value="False" />
                                        <Condition Binding="{Binding IsListEmpty}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Style="{StaticResource Dyc.Panel.Section}"
                        BorderBrush="{DynamicResource Dyc.ErrorBrush}"
                        Visibility="{Binding HasLoadError, Converter={StaticResource Dyc.BoolToVisibility}}">
                    <TextBlock Text="{Binding LoadError}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Dyc.ErrorBrush}" />
                </Border>

                <StackPanel Visibility="{Binding HasScript, Converter={StaticResource Dyc.BoolToVisibility}}">

                    <!-- Notes about the script that matter before it is run. -->
                    <Border Background="{DynamicResource Dyc.HoverBrush}"
                            BorderBrush="{DynamicResource Dyc.WarningBrush}"
                            BorderThickness="3,0,0,0"
                            CornerRadius="4"
                            Padding="10,7"
                            Margin="0,0,0,10"
                            Visibility="{Binding HasModifies, Converter={StaticResource Dyc.BoolToVisibility}}">
                        <TextBlock Text="{Binding ModifiesText}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Dyc.TextBrush}" />
                    </Border>
                    <Border Background="{DynamicResource Dyc.HoverBrush}"
                            BorderBrush="{DynamicResource Dyc.ErrorBrush}"
                            BorderThickness="3,0,0,0"
                            CornerRadius="4"
                            Padding="10,7"
                            Margin="0,0,0,10"
                            Visibility="{Binding HasMissing, Converter={StaticResource Dyc.BoolToVisibility}}">
                        <TextBlock Text="{Binding MissingText}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Dyc.TextBrush}" />
                    </Border>

                    <!-- The form: the same inline editors the nodes use, in roomier versions. -->
                    <Border x:Name="InputsCard" Style="{StaticResource Dyc.Panel.Section}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Dyc.Panel.Eyebrow}"
                                       Text="INPUTS"
                                       Margin="0,0,0,12"
                                       Visibility="{Binding HasFields, Converter={StaticResource Dyc.BoolToVisibility}}" />

                            <ItemsControl ItemsSource="{Binding Fields}" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding Connector.ShowPlainLabel, Converter={StaticResource Dyc.BoolToVisibility}}">
                                                    <TextBlock Text="{Binding Label}"
                                                               FontSize="12"
                                                               Margin="0,0,0,5"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Dyc.TextBrush}" />
                                                    <Ellipse Width="6" Height="6" Margin="6,-3,0,0"
                                                             Fill="{DynamicResource Dyc.AccentBrush}"
                                                             ToolTip="Changed from the value saved in the script"
                                                             Visibility="{Binding IsChanged, Converter={StaticResource Dyc.BoolToVisibility}}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="10.5"
                                                           Margin="0,-3,0,5"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                                                           Visibility="{Binding HasDetail, Converter={StaticResource Dyc.BoolToVisibility}}" />
                                            </StackPanel>

                                            <!-- Where the editor and the reset button sit depends on the kind of field: an on/off switch shares the
                                                 label's row; every other field has its own row under the label. -->
                                            <ContentControl Content="{Binding Connector}">
                                                <ContentControl.Style>
                                                    <Style TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Dyc.PlayerEditorHost}">
                                                        <Setter Property="Grid.Row" Value="1" />
                                                        <Setter Property="Grid.Column" Value="0" />
                                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Connector.EditorKind}" Value="Toggle">
                                                                <Setter Property="Grid.Row" Value="0" />
                                                                <Setter Property="Grid.Column" Value="1" />
                                                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                                <Setter Property="Margin" Value="12,0,0,0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <Button Grid.Column="2"
                                                    Width="28" Height="28"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Content="↺"
                                                    ToolTip="Back to the value saved in the script"
                                                    Command="{Binding ResetCommand}"
                                                    Visibility="{Binding IsChanged, Converter={StaticResource Dyc.BoolToVisibility}}">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Dyc.Panel.IconButton}">
                                                        <Setter Property="Grid.Row" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Connector.EditorKind}" Value="Toggle">
                                                                <Setter Property="Grid.Row" Value="0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="This script asks for nothing — it just runs."
                                       FontSize="12"
                                       Foreground="{DynamicResource Dyc.SubtleTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFields}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Results -->
                    <Border x:Name="ResultsCard"
                            Style="{StaticResource Dyc.Panel.Section}"
                            Margin="0,12,0,0"
                            Visibility="{Binding HasResult, Converter={StaticResource Dyc.BoolToVisibility}}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource Dyc.Panel.GhostButton}"
                                        Content="Copy"
                                        MinHeight="26"
                                        Padding="10,0"
                                        FontSize="11.5"
                                        ToolTip="Copy the results as text"
                                        VerticalAlignment="Center"
                                        Command="{Binding CopyResultsCommand}" />
                                <TextBlock Style="{StaticResource Dyc.Panel.Eyebrow}" Text="RESULTS" VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- The status line: green when the run finished, red when it did not. -->
                            <DockPanel Margin="0,10,0,0">
                                <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,1,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Fill" Value="{DynamicResource Dyc.FnCreateBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ResultSucceeded}" Value="False">
                                                    <Setter Property="Fill" Value="{DynamicResource Dyc.ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ResultSucceeded}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource Dyc.ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding Outputs}" Margin="0,10,0,0" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="11"
                                                       Margin="0,0,0,4"
                                                       Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                                            <TextBox Style="{StaticResource Player.OutputBox}"
                                                     Text="{Binding Text, Mode=OneWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Problems}" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,4,8,0" VerticalAlignment="Top" Fill="{DynamicResource Dyc.WarningBrush}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Dyc.TextBrush}">
                                                <Run Text="{Binding Node, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Text, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Dyc.ErrorBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
