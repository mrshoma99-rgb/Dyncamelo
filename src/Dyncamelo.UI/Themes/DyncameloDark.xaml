    <!-- Reusable toolbar icon: 13px, filled with the text colour, spaced before a label. -->
    <Style x:Key="Dyc.ToolIcon" TargetType="{x:Type Path}">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
        <Setter Property="Fill" Value="{DynamicResource Dyc.TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>


    <!-- ===== Menus & tooltips follow the palette (else they keep system/Nodify
         colours and go white-on-white when the Light palette is active). ===== -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource Dyc.PanelBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Dyc.PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
    </Style>
    <!-- ===== Slim scroll bars in the palette. The stock Windows bar is a wide grey track with arrow buttons that clashes
         with the theme, and its gutter is what made menus look like they always had a scroll bar. The ScrollViewer still
         decides whether a bar is needed; this only styles it (a thin thumb, no arrows, transparent track). Menu popups never
         show a bar at all (VerticalScrollBarVisibility="Hidden": the wheel and arrow keys still scroll a menu taller than the
         screen), because an Auto bar was measured as needed even when every item fit. ===== -->
    <Style x:Key="Dyc.ScrollTrackButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Dyc.ScrollThumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Bar"
                            CornerRadius="3"
                            Margin="2"
                            Opacity="0.45"
                            Background="{DynamicResource Dyc.SubtleTextBrush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="11" />
        <Setter Property="MinWidth" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Dyc.ScrollTrackButton}" Command="{x:Static ScrollBar.PageUpCommand}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Dyc.ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Dyc.ScrollTrackButton}" Command="{x:Static ScrollBar.PageDownCommand}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="Height" Value="11" />
                            <Setter Property="MinHeight" Value="11" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Retemplated so the default WPF ContextMenu chrome is gone: the stock
         template paints a light "icon gutter" strip down the left edge that,
         over the dark panel, shows as a white stripe overlapping the items.
         This template is just the themed border + items (matching the submenu
         popup below), so there is no gutter. -->
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource Dyc.PanelBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Dyc.PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="3"
                            SnapsToDevicePixels="True">
                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Fully themed menu item. Crucially it templates the SUBMENU popup with a
         dark themed border — WPF's default leaves that popup system-white, which
         with light text reads white-on-white (the Open ▾ Recent/Sample lists).
         Keyed so the explicit menu styles in the view can inherit it via BasedOn. -->
    <Style x:Key="Dyc.MenuItem" TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Margin="2,1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="Check"
                                  Grid.Column="0"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Data="M0,4 L3,7 L8,0"
                                  Stroke="{DynamicResource Dyc.AccentBrush}"
                                  StrokeThickness="1.6"
                                  Visibility="Collapsed" />
                            <ContentPresenter x:Name="HeaderHost"
                                              Grid.Column="1"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              Margin="4,5,10,5" />
                            <TextBlock Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                            <Path x:Name="Arrow"
                                  Grid.Column="3"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"
                                  Data="M0,0 L4,4 L0,8 Z"
                                  Fill="{DynamicResource Dyc.SubtleTextBrush}"
                                  Visibility="Collapsed" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Right"
                                   HorizontalOffset="-2"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   Focusable="False"
                                   PopupAnimation="None">
                                <Border Background="{DynamicResource Dyc.PanelBrush}"
                                        BorderBrush="{DynamicResource Dyc.PanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="3"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Top-level item of the header menu bar: a flat label whose dropdown opens
         BELOW it (Dyc.MenuItem is built for submenus and opens to the right). -->
    <Style x:Key="Dyc.TopMenuItem" TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="9,3"
                            Margin="1,0"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   Focusable="False"
                                   PopupAnimation="None">
                                <Border Background="{DynamicResource Dyc.PanelBrush}"
                                        BorderBrush="{DynamicResource Dyc.PanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="3"
                                        MinWidth="230"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Apply the themed item to every menu that doesn't set its own style. -->
    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource Dyc.MenuItem}" />
    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource Dyc.PanelBorderBrush}" />
    </Style>

    <!-- ===== Small controls used inside nodes and the chrome =====
         Rounded, flat field matching the BIMCamel TextBox (CornerRadius 6, accent
         focus ring). Templated so the corners actually round. -->
    <Style x:Key="Dyc.TextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource Dyc.InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Dyc.InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource Dyc.TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Dyc.AccentBrush}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <!-- No forced VerticalAlignment: single-line boxes centre via
                             VerticalContentAlignment; multiline Watch boxes fill and scroll. -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Themed dropdown for inline choice/enum input ports =====
         Rounded flat field matching Dyc.TextBox, a dark popup list with hover
         highlight. Used by the NodeInput header for ports that declare a fixed
         set of choices (selection levels, clash types, export schemas, ...). -->
    <Style x:Key="Dyc.ComboBoxToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bd"
                            Background="{DynamicResource Dyc.InputBackgroundBrush}"
                            BorderBrush="{DynamicResource Dyc.InputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Path x:Name="Arrow"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,7,0"
                              Data="M0,0 L4,4 L8,0 Z"
                              Fill="{DynamicResource Dyc.SubtleTextBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dyc.ComboBoxItem" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dyc.ComboBox" TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource Dyc.InputBackgroundBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Height" Value="22" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Dyc.ComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Style="{StaticResource Dyc.ComboBoxToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="8,0,20,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          TextElement.Foreground="{DynamicResource Dyc.TextBrush}" />
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border Background="{DynamicResource Dyc.PanelBrush}"
                                    BorderBrush="{DynamicResource Dyc.PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,2,0,0"
                                    MaxHeight="220"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact icon-only button (square, rounded) for chrome affordances such as
         the library expand/collapse controls next to the search box. -->
    <Style x:Key="Dyc.IconButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Dyc.SubtleTextBrush}" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Dyc.InputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dyc.InputBackgroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dyc.ToolButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dyc.InputBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dyc.ToolToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dyc.SmallButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Dyc.ToolButton}">
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Dyc.InputBorderBrush}" />
    </Style>

    <Style x:Key="Dyc.SmallToggle" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource Dyc.ToolToggle}">
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Dyc.InputBorderBrush}" />
    </Style>

    <!-- A full-width selectable row in the settings panel; the selected option
         (ChoiceOption.IsSelected) shows an accent border. -->
    <Style x:Key="Dyc.SettingsChoice" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Library search results (flat Dynamo-style list while searching) ===== -->
    <Style x:Key="Dyc.LibraryResultItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1,0,0,0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Canvas item container (nodes + notes + groups) =====
         Nodify's default ItemContainer style draws a 1px DodgerBlue border
         around EVERY container (BorderBrush setter in Controls.xaml resolving
         ItemContainer.BorderBrush/BorderColor from the Dark theme). Kill it for
         unselected items by overriding the container's BorderBrush; the
         selected/previewing-selection triggers still swap the border to
         SelectedBrush (verified against the 7.3.0 ItemContainer template),
         which we soften to a subtle accent. Warning/error state borders are
         drawn by the node template itself and remain untouched. -->
    <Style x:Key="Dyc.ItemContainerStyle" TargetType="{x:Type nodify:ItemContainer}"
           BasedOn="{StaticResource {x:Type nodify:ItemContainer}}">
        <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="ActualSize" Value="{Binding Size, Mode=OneWayToSource}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="SelectedBrush" Value="{DynamicResource Dyc.SelectionBorderBrush}" />
        <Setter Property="HighlightBrush" Value="{DynamicResource Dyc.SelectionBorderBrush}" />
    </Style>

    <!-- ===== Connector (port) visuals: required inputs are filled, inputs with a
         default value are hollow/dimmed. Both light up when connected. ===== -->
    <ControlTemplate x:Key="Dyc.RequiredConnectorTemplate" TargetType="{x:Type Control}">
        <Ellipse x:Name="Dot"
                 Width="11" Height="11"
                 Fill="{DynamicResource Dyc.WireBrush}"
                 Stroke="{DynamicResource Dyc.WireBrush}"
                 StrokeThickness="1.5" />
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Dyc.AccentBrush}" />
                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Dyc.AccentBrush}" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Dyc.OptionalConnectorTemplate" TargetType="{x:Type Control}">
        <Ellipse x:Name="Dot"
                 Width="11" Height="11"
                 Fill="Transparent"
                 Stroke="{DynamicResource Dyc.SubtleTextBrush}"
                 StrokeThickness="1.5" />
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Dyc.AccentBrush}" />
                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Dyc.AccentBrush}" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type nodify:NodeInput}" BasedOn="{StaticResource {x:Type nodify:NodeInput}}">
        <Setter Property="Header" Value="{Binding}" />
        <Setter Property="IsConnected" Value="{Binding IsConnected}" />
        <Setter Property="Anchor" Value="{Binding Anchor, Mode=OneWayToSource}" />
        <Setter Property="ToolTip" Value="{Binding ToolTip}" />
        <Setter Property="ConnectorTemplate" Value="{StaticResource Dyc.RequiredConnectorTemplate}" />
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem Header="Disconnect" Command="{Binding DisconnectCommand}" />
                    <MenuItem Header="Show in Player"
                              Command="{Binding TogglePlayerCommand}"
                              IsChecked="{Binding IsPlayerExposed, Mode=OneWay}"
                              Visibility="{Binding CanBePlayerField, Converter={StaticResource Dyc.BoolToVisibility}}"
                              ToolTip="Offer this input as a field of the Script Player's form, so the script can be run without the editor." />
                    <Separator />
                    <!-- Dynamo's List@Level: pick which depth of a nested list
                         this input consumes (L1 = innermost items). -->
                    <MenuItem Header="List Levels">
                        <MenuItem Header="Use Levels"
                                  IsCheckable="True"
                                  IsChecked="{Binding UseLevels}" />
                        <Separator />
                        <MenuItem Header="@L1 — items"
                                  Command="{Binding SetLevelCommand}" CommandParameter="1"
                                  IsChecked="{Binding IsLevel1, Mode=OneWay}" />
                        <MenuItem Header="@L2 — lists of items"
                                  Command="{Binding SetLevelCommand}" CommandParameter="2"
                                  IsChecked="{Binding IsLevel2, Mode=OneWay}" />
                        <MenuItem Header="@L3"
                                  Command="{Binding SetLevelCommand}" CommandParameter="3"
                                  IsChecked="{Binding IsLevel3, Mode=OneWay}" />
                        <MenuItem Header="@L4"
                                  Command="{Binding SetLevelCommand}" CommandParameter="4"
                                  IsChecked="{Binding IsLevel4, Mode=OneWay}" />
                        <Separator />
                        <MenuItem Header="Keep list structure"
                                  IsCheckable="True"
                                  IsChecked="{Binding KeepListStructure}" />
                    </MenuItem>
                    <Separator Visibility="{Binding IsGroupSocket, Converter={StaticResource Dyc.BoolToVisibility}}" />
                    <MenuItem Header="Rename Socket…" Command="{Binding RenameSocketCommand}" Visibility="{Binding IsGroupSocket, Converter={StaticResource Dyc.BoolToVisibility}}" />
                    <MenuItem Header="Remove Socket" Command="{Binding RemoveSocketCommand}" Visibility="{Binding IsGroupSocket, Converter={StaticResource Dyc.BoolToVisibility}}" />
                    <MenuItem Header="Move Up" Command="{Binding MoveSocketUpCommand}" Visibility="{Binding IsGroupSocket, Converter={StaticResource Dyc.BoolToVisibility}}" />
                    <MenuItem Header="Move Down" Command="{Binding MoveSocketDownCommand}" Visibility="{Binding IsGroupSocket, Converter={StaticResource Dyc.BoolToVisibility}}" />
                    <MenuItem Header="Socket Type" Visibility="{Binding IsGroupSocket, Converter={StaticResource Dyc.BoolToVisibility}}">
                        <MenuItem Header="Any" Command="{Binding SetSocketKindCommand}" CommandParameter="" />
                        <MenuItem Header="Number" Command="{Binding SetSocketKindCommand}" CommandParameter="number" />
                        <MenuItem Header="Integer" Command="{Binding SetSocketKindCommand}" CommandParameter="integer" />
                        <MenuItem Header="Boolean" Command="{Binding SetSocketKindCommand}" CommandParameter="boolean" />
                        <MenuItem Header="Text" Command="{Binding SetSocketKindCommand}" CommandParameter="text" />
                        <MenuItem Header="Colour" Command="{Binding SetSocketKindCommand}" CommandParameter="colour" />
                        <MenuItem Header="Geometry" Command="{Binding SetSocketKindCommand}" CommandParameter="geometry" />
                        <MenuItem Header="Model item" Command="{Binding SetSocketKindCommand}" CommandParameter="item" />
                        <MenuItem Header="Selection" Command="{Binding SetSocketKindCommand}" CommandParameter="selection" />
                        <MenuItem Header="Viewpoint" Command="{Binding SetSocketKindCommand}" CommandParameter="viewpoint" />
                        <Separator />
                        <MenuItem Header="Number list" Command="{Binding SetSocketKindCommand}" CommandParameter="number*" />
                        <MenuItem Header="Integer list" Command="{Binding SetSocketKindCommand}" CommandParameter="integer*" />
                        <MenuItem Header="Boolean list" Command="{Binding SetSocketKindCommand}" CommandParameter="boolean*" />
                        <MenuItem Header="Text list" Command="{Binding SetSocketKindCommand}" CommandParameter="text*" />
                        <MenuItem Header="Colour list" Command="{Binding SetSocketKindCommand}" CommandParameter="colour*" />
                        <MenuItem Header="Geometry list" Command="{Binding SetSocketKindCommand}" CommandParameter="geometry*" />
                        <MenuItem Header="Model item list" Command="{Binding SetSocketKindCommand}" CommandParameter="item*" />
                        <MenuItem Header="Selection list" Command="{Binding SetSocketKindCommand}" CommandParameter="selection*" />
                        <MenuItem Header="Viewpoint list" Command="{Binding SetSocketKindCommand}" CommandParameter="viewpoint*" />
                    </MenuItem>
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{DynamicResource Dyc.TextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                        <!-- List@Level badge (right-click the port to change). -->
                        <TextBlock Text="{Binding LevelLabel}"
                                   Margin="4,0,0,0"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Dyc.AccentBrush}"
                                   ToolTip="This input consumes the incoming list at this level (right-click the port to change). Counted from the innermost: @L1 = items, @L2 = lists of items."
                                   Visibility="{Binding HasLevels, Converter={StaticResource Dyc.BoolToVisibility}}" />
                        <!-- Inline dropdown for unconnected choice ports (selection
                             levels, clash types, ...); collapsed for every other port. -->
                        <ComboBox Style="{StaticResource Dyc.ComboBox}"
                                  Margin="6,0,0,0"
                                  MinWidth="96"
                                  ItemsSource="{Binding Choices}"
                                  SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                  Visibility="{Binding ShowChoiceEditor, Converter={StaticResource Dyc.BoolToVisibility}}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsOptional}" Value="True">
                <Setter Property="ConnectorTemplate" Value="{StaticResource Dyc.OptionalConnectorTemplate}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type nodify:NodeOutput}" BasedOn="{StaticResource {x:Type nodify:NodeOutput}}">
        <Setter Property="Header" Value="{Binding}" />
        <Setter Property="IsConnected" Value="{Binding IsConnected}" />
        <Setter Property="Anchor" Value="{Binding Anchor, Mode=OneWayToSource}" />
        <Setter Property="ToolTip" Value="{Binding ToolTip}" />
        <Setter Property="ConnectorTemplate" Value="{StaticResource Dyc.RequiredConnectorTemplate}" />
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem Header="Disconnect" Command="{Binding DisconnectCommand}" />
                    <Separator Visibility="{Binding IsGroupSocket, Converter={StaticResource Dyc.BoolToVisibility}}" />
                    <MenuItem Header="Rename Socket…" Command="{Binding RenameSocketCommand}" Visibility="{Binding IsGroupSocket, Converter={StaticResource Dyc.BoolToVisibility}}" />
                    <MenuItem Header="Remove Socket" Command="{Binding RemoveSocketCommand}" Visibility="{Binding IsGroupSocket, Converter={StaticResource Dyc.BoolToVisibility}}" />
                    <MenuItem Header="Move Up" Command="{Binding MoveSocketUpCommand}" Visibility="{Binding IsGroupSocket, Converter={StaticResource Dyc.BoolToVisibility}}" />
                    <MenuItem Header="Move Down" Command="{Binding MoveSocketDownCommand}" Visibility="{Binding IsGroupSocket, Converter={StaticResource Dyc.BoolToVisibility}}" />
                    <MenuItem Header="Socket Type" Visibility="{Binding IsGroupSocket, Converter={StaticResource Dyc.BoolToVisibility}}">
                        <MenuItem Header="Any" Command="{Binding SetSocketKindCommand}" CommandParameter="" />
                        <MenuItem Header="Number" Command="{Binding SetSocketKindCommand}" CommandParameter="number" />
                        <MenuItem Header="Integer" Command="{Binding SetSocketKindCommand}" CommandParameter="integer" />
                        <MenuItem Header="Boolean" Command="{Binding SetSocketKindCommand}" CommandParameter="boolean" />
                        <MenuItem Header="Text" Command="{Binding SetSocketKindCommand}" CommandParameter="text" />
                        <MenuItem Header="Colour" Command="{Binding SetSocketKindCommand}" CommandParameter="colour" />
                        <MenuItem Header="Geometry" Command="{Binding SetSocketKindCommand}" CommandParameter="geometry" />
                        <MenuItem Header="Model item" Command="{Binding SetSocketKindCommand}" CommandParameter="item" />
                        <MenuItem Header="Selection" Command="{Binding SetSocketKindCommand}" CommandParameter="selection" />
                        <MenuItem Header="Viewpoint" Command="{Binding SetSocketKindCommand}" CommandParameter="viewpoint" />
                        <Separator />
                        <MenuItem Header="Number list" Command="{Binding SetSocketKindCommand}" CommandParameter="number*" />
                        <MenuItem Header="Integer list" Command="{Binding SetSocketKindCommand}" CommandParameter="integer*" />
                        <MenuItem Header="Boolean list" Command="{Binding SetSocketKindCommand}" CommandParameter="boolean*" />
                        <MenuItem Header="Text list" Command="{Binding SetSocketKindCommand}" CommandParameter="text*" />
                        <MenuItem Header="Colour list" Command="{Binding SetSocketKindCommand}" CommandParameter="colour*" />
                        <MenuItem Header="Geometry list" Command="{Binding SetSocketKindCommand}" CommandParameter="geometry*" />
                        <MenuItem Header="Model item list" Command="{Binding SetSocketKindCommand}" CommandParameter="item*" />
                        <MenuItem Header="Selection list" Command="{Binding SetSocketKindCommand}" CommandParameter="selection*" />
                        <MenuItem Header="Viewpoint list" Command="{Binding SetSocketKindCommand}" CommandParameter="viewpoint*" />
                    </MenuItem>
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}"
                               Foreground="{DynamicResource Dyc.TextBrush}"
                               FontSize="11" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Wires (click to select, Delete or context menu to remove) ===== -->
    <!-- Row-layout wire: family-coloured soft Bézier; dashed when the node will
         replicate over a list, accent when selected, straight hairline in overview. -->
    <DoubleCollection x:Key="Dyc.WireDash">4 3</DoubleCollection>
    <DataTemplate x:Key="Dyc.Wire.Blender">
        <views:DycWire nodify:BaseConnection.IsSelectable="True"
                       Source="{Binding Source.Anchor}"
                       Target="{Binding TargetAnchor}"
                       IsMuted="{Binding IsMuted}"
                       IsLowDetail="{Binding DataContext.WireLowDetail, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}">
            <views:DycWire.Style>
                <Style TargetType="{x:Type views:DycWire}" BasedOn="{StaticResource {x:Type nodify:BaseConnection}}">
                    <Setter Property="Stroke" Value="{Binding FamilyBrush}" />
                    <Setter Property="StrokeThickness" Value="2" />
                    <Setter Property="StrokeLineJoin" Value="Round" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsReplicating}" Value="True">
                            <Setter Property="StrokeDashArray" Value="{StaticResource Dyc.WireDash}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                            <Setter Property="Opacity" Value="0.35" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsEmphasised}" Value="True">
                            <Setter Property="StrokeThickness" Value="3" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="StrokeThickness" Value="3.5" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource Dyc.AccentBrush}" />
                            <Setter Property="StrokeThickness" Value="3" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsInsertTarget}" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource Dyc.TextBrush}" />
                            <Setter Property="StrokeThickness" Value="4.5" />
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:DycWire.Style>
            <views:DycWire.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Disconnect" Command="{Binding DisconnectCommand}" />
                </ContextMenu>
            </views:DycWire.ContextMenu>
        </views:DycWire>
    </DataTemplate>

    <!-- What the editor instantiates for every wire. -->
    <DataTemplate x:Key="Dyc.ConnectionTemplate" DataType="{x:Type vm:ConnectionViewModel}">
        <ContentControl Content="{Binding}"
                        Focusable="False"
                        IsTabStop="False"
                        ContentTemplate="{StaticResource Dyc.Wire.Blender}" />
    </DataTemplate>

    <DataTemplate x:Key="Dyc.PendingConnectionTemplate" DataType="{x:Type vm:PendingConnectionViewModel}">
        <nodify:PendingConnection IsVisible="{Binding IsVisible}"
                                  Source="{Binding Source, Mode=OneWayToSource}"
                                  Target="{Binding Target, Mode=OneWayToSource}"
                                  SourceAnchor="{Binding SourceLocation, Mode=TwoWay}"
                                  TargetAnchor="{Binding TargetLocation, Mode=OneWayToSource}"
                                  EnableSnapping="True"
                                  AllowOnlyConnectors="True"
                                  Stroke="{DynamicResource Dyc.AccentBrush}"
                                  StrokeThickness="2"
                                  StartedCommand="{Binding DataContext.StartConnectionCommand, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                  CompletedCommand="{Binding DataContext.CreateConnectionCommand, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}" />
    </DataTemplate>

    <!-- ===== Node body (inline editor) templates, chosen by Dyc.NodeBodySelector ===== -->
    <DataTemplate x:Key="NodeBody.Empty">
        <Border Height="2" MinWidth="40" Background="Transparent" />
    </DataTemplate>

    <DataTemplate x:Key="NodeBody.NumberInput">
        <views:ScrubNumberBox Margin="4"
                              MinWidth="110"
                              Label="Value"
                              Value="{Binding Value, Mode=TwoWay}"
                              Step="1"
                              LiveCommit="{Binding DataContext.LiveScrubEvaluation, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      PixelsPerStep="{Binding DataContext.ScrubPixelsPerStep, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                              ToolTip="Drag to scrub (Shift = fine, Ctrl = snap), click to type a number or arithmetic such as 2*3+1." />
    </DataTemplate>

    <DataTemplate x:Key="NodeBody.NumberSlider">
        <!-- The same scrub field as every other number in the editor; the slider fill shows the position between min and max. -->
        <StackPanel Margin="4" MinWidth="200">
            <views:ScrubNumberBox Label="Value"
                                  Value="{Binding Value, Mode=TwoWay}"
                                  Minimum="{Binding Min}"
                                  Maximum="{Binding Max}"
                                  SoftMinimum="{Binding Min}"
                                  SoftMaximum="{Binding Max}"
                                  Step="{Binding Step}"
                                  LiveCommit="{Binding DataContext.LiveScrubEvaluation, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      PixelsPerStep="{Binding DataContext.ScrubPixelsPerStep, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                  ToolTip="Drag to scrub (Shift = fine, Ctrl = snap), click to type." />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <views:ScrubNumberBox Grid.Column="0" Margin="0,0,2,0"
                                      Label="min"
                                      Value="{Binding Min, Mode=TwoWay}"
                                      Step="{Binding Step}"
                                      LiveCommit="{Binding DataContext.LiveScrubEvaluation, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      PixelsPerStep="{Binding DataContext.ScrubPixelsPerStep, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      ToolTip="Lowest value of the slider" />
                <views:ScrubNumberBox Grid.Column="1" Margin="2,0"
                                      Label="max"
                                      Value="{Binding Max, Mode=TwoWay}"
                                      Step="{Binding Step}"
                                      LiveCommit="{Binding DataContext.LiveScrubEvaluation, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      PixelsPerStep="{Binding DataContext.ScrubPixelsPerStep, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      ToolTip="Highest value of the slider" />
                <views:ScrubNumberBox Grid.Column="2" Margin="2,0,0,0"
                                      Label="step"
                                      Value="{Binding Step, Mode=TwoWay}"
                                      Minimum="0.000001"
                                      LiveCommit="{Binding DataContext.LiveScrubEvaluation, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      PixelsPerStep="{Binding DataContext.ScrubPixelsPerStep, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      ToolTip="Step size (the field snaps to this)" />
            </Grid>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="NodeBody.IntegerSlider">
        <!-- The same scrub field as every other number in the editor; the slider fill shows the position between min and max. -->
        <StackPanel Margin="4" MinWidth="200">
            <views:ScrubNumberBox Label="Value"
                                  Value="{Binding Value, Mode=TwoWay}"
                                  Minimum="{Binding Min}"
                                  Maximum="{Binding Max}"
                                  SoftMinimum="{Binding Min}"
                                  SoftMaximum="{Binding Max}"
                                  Step="{Binding Step}" IsInteger="True"
                                  LiveCommit="{Binding DataContext.LiveScrubEvaluation, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      PixelsPerStep="{Binding DataContext.ScrubPixelsPerStep, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                  ToolTip="Drag to scrub (Shift = fine, Ctrl = snap), click to type." />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <views:ScrubNumberBox Grid.Column="0" Margin="0,0,2,0"
                                      Label="min" IsInteger="True"
                                      Value="{Binding Min, Mode=TwoWay}"
                                      Step="{Binding Step}"
                                      LiveCommit="{Binding DataContext.LiveScrubEvaluation, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      PixelsPerStep="{Binding DataContext.ScrubPixelsPerStep, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      ToolTip="Lowest value of the slider" />
                <views:ScrubNumberBox Grid.Column="1" Margin="2,0"
                                      Label="max" IsInteger="True"
                                      Value="{Binding Max, Mode=TwoWay}"
                                      Step="{Binding Step}"
                                      LiveCommit="{Binding DataContext.LiveScrubEvaluation, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      PixelsPerStep="{Binding DataContext.ScrubPixelsPerStep, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      ToolTip="Highest value of the slider" />
                <views:ScrubNumberBox Grid.Column="2" Margin="2,0,0,0"
                                      Label="step" IsInteger="True"
                                      Value="{Binding Step, Mode=TwoWay}"
                                      Minimum="1"
                                      LiveCommit="{Binding DataContext.LiveScrubEvaluation, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      PixelsPerStep="{Binding DataContext.ScrubPixelsPerStep, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      ToolTip="Step size (the field snaps to this)" />
            </Grid>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="NodeBody.IntegerInput">
        <views:ScrubNumberBox Margin="4"
                              MinWidth="110"
                              Label="Value"
                              IsInteger="True"
                              Value="{Binding Value, Mode=TwoWay}"
                              Step="1"
                              LiveCommit="{Binding DataContext.LiveScrubEvaluation, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                              PixelsPerStep="{Binding DataContext.ScrubPixelsPerStep, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                              ToolTip="Drag to scrub (Shift = fine, Ctrl = snap), click to type a whole number." />
    </DataTemplate>

    <!-- A date typed as text (2026-10-01 or 2026-10-01 14:30); a warning appears while it does not read as a date. -->
    <DataTemplate x:Key="NodeBody.DateInput">
        <StackPanel Margin="4" MinWidth="130">
            <TextBox Style="{StaticResource Dyc.TextBox}"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Type a date like 2026-10-01, or with a time: 2026-10-01 14:30" />
            <TextBlock Margin="0,3,0,0"
                       FontSize="10"
                       Foreground="{DynamicResource Dyc.ErrorBrush}"
                       Text="Not a date — use 2026-10-01"
                       Visibility="{Binding IsInvalid, Converter={StaticResource Dyc.BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <!-- A pick-list with the author's own options: the dropdown picks, the box below lists them one per line. -->
    <DataTemplate x:Key="NodeBody.Choice">
        <StackPanel Margin="4" MinWidth="150">
            <ComboBox Style="{StaticResource Dyc.ComboBox}"
                      Height="22"
                      ItemsSource="{Binding Options}"
                      SelectedItem="{Binding Value, Mode=TwoWay}" />
            <TextBlock Margin="0,5,0,2"
                       FontSize="10"
                       Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                       Text="Options, one per line" />
            <TextBox Style="{StaticResource Dyc.TextBox}"
                     MinHeight="48"
                     MaxHeight="120"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding OptionsText, UpdateSourceTrigger=LostFocus}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="NodeBody.StringInput">
        <TextBox Style="{StaticResource Dyc.TextBox}"
                 MinWidth="130"
                 MaxWidth="260"
                 Margin="4"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Text="{Binding Value}" />
    </DataTemplate>

    <!-- Boolean input as a proper switch: a rounded track whose thumb slides
         right and fills with the accent colour when true, plus a True/False
         state label. Clicking anywhere on the row toggles. -->
    <DataTemplate x:Key="NodeBody.BooleanToggle">
        <CheckBox Margin="8,6"
                  MinWidth="96"
                  Cursor="Hand"
                  IsChecked="{Binding Value}">
            <CheckBox.Template>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Track"
                                Width="34" Height="18"
                                CornerRadius="9"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Dyc.InputBackgroundBrush}"
                                BorderBrush="{DynamicResource Dyc.InputBorderBrush}"
                                BorderThickness="1">
                            <Ellipse x:Name="Thumb"
                                     Width="12" Height="12"
                                     Margin="2,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource Dyc.SubtleTextBrush}" />
                        </Border>
                        <TextBlock x:Name="StateText"
                                   Text="False"
                                   Margin="8,0,0,0"
                                   MinWidth="32"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Dyc.AccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Fill" Value="White" />
                            <Setter TargetName="StateText" Property="Text" Value="True" />
                            <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </CheckBox.Template>
        </CheckBox>
    </DataTemplate>

    <DataTemplate x:Key="NodeBody.FilePath">
        <DockPanel Margin="4" MinWidth="170">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource Dyc.SmallButton}"
                    Margin="4,0,0,0"
                    Content="…"
                    ToolTip="Browse for a file"
                    Command="{Binding DataContext.BrowseFileCommand, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}}" />
            <TextBox Style="{StaticResource Dyc.TextBox}" Text="{Binding Path}" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="NodeBody.DirectoryPath">
        <DockPanel Margin="4" MinWidth="170">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource Dyc.SmallButton}"
                    Margin="4,0,0,0"
                    Content="…"
                    ToolTip="Browse for a folder"
                    Command="{Binding DataContext.BrowseFileCommand, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}}" />
            <TextBox Style="{StaticResource Dyc.TextBox}"
                     Text="{Binding Path}"
                     ToolTip="Type or paste a directory path" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="NodeBody.Watch">
        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Margin="1,0,1,3"
                       FontSize="10"
                       Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                       Text="{Binding DataContext.WatchCountText, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}}"
                       Visibility="{Binding DataContext.HasWatchCount, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}, Converter={StaticResource Dyc.BoolToVisibility}}" />
            <TextBox x:Name="WatchBox"
                     Grid.Row="1"
                     Style="{StaticResource Dyc.TextBox}"
                     MinWidth="120"
                     MinHeight="24"
                     Width="{Binding DataContext.WatchWidth, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}}"
                     Height="{Binding DataContext.WatchHeight, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}}"
                     MaxWidth="{Binding DataContext.WatchWidth, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}, Converter={StaticResource Dyc.AutoSizeLimit}, ConverterParameter=280}"
                     MaxHeight="{Binding DataContext.WatchHeight, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}, Converter={StaticResource Dyc.AutoSizeLimit}, ConverterParameter=200}"
                     FontFamily="Consolas"
                     FontSize="11"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding FormattedValue, Mode=OneWay}" />
            <views:SizeGripThumb Grid.Row="2"
                                 HorizontalAlignment="Right"
                                 Width="14"
                                 Height="12"
                                 Margin="0,2,0,0"
                                 ToolTip="Drag to resize"
                                 TargetElement="{Binding ElementName=WatchBox}"
                                 TargetWidth="{Binding DataContext.WatchWidth, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}, Mode=TwoWay}"
                                 TargetHeight="{Binding DataContext.WatchHeight, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}, Mode=TwoWay}"
                                 MinTargetWidth="120"
                                 MinTargetHeight="24">
                <views:SizeGripThumb.Template>
                    <ControlTemplate TargetType="{x:Type views:SizeGripThumb}">
                        <Grid Background="Transparent">
                            <Path Data="M 12,2 L 2,12 M 12,7 L 7,12"
                                  Stroke="{DynamicResource Dyc.SubtleTextBrush}"
                                  StrokeThickness="1.5" />
                        </Grid>
                    </ControlTemplate>
                </views:SizeGripThumb.Template>
            </views:SizeGripThumb>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="NodeBody.Missing">
        <TextBlock Margin="6,4"
                   MaxWidth="240"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="{DynamicResource Dyc.ErrorBrush}"
                   Text="{Binding Reason}" />
    </DataTemplate>

    <!-- Bodies for Dyncamelo.Nodes interactive nodes (matched by type name;
         bindings resolve reflectively, so no assembly reference is needed). -->
    <DataTemplate x:Key="NodeBody.WatchListNode">
        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Margin="1,0,1,3"
                       FontSize="10"
                       Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                       Text="{Binding DataContext.WatchCountText, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}}"
                       Visibility="{Binding DataContext.HasWatchCount, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}, Converter={StaticResource Dyc.BoolToVisibility}}" />
            <!-- Two-column rows: a right-aligned index gutter with a separator
                 rule, then the value. A retemplated ListBox supplies scrolling
                 AND row virtualization (an ItemsControl in a ScrollViewer
                 would realize every row of a 100k-item list). -->
            <Border x:Name="WatchListBox"
                    Grid.Row="1"
                    Background="{DynamicResource Dyc.InputBackgroundBrush}"
                    BorderBrush="{DynamicResource Dyc.InputBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="6,3"
                    MinWidth="140"
                    MinHeight="24"
                    Width="{Binding DataContext.WatchWidth, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}}"
                    Height="{Binding DataContext.WatchHeight, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}}"
                    MaxWidth="{Binding DataContext.WatchWidth, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}, Converter={StaticResource Dyc.AutoSizeLimit}, ConverterParameter=280}"
                    MaxHeight="{Binding DataContext.WatchHeight, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}, Converter={StaticResource Dyc.AutoSizeLimit}, ConverterParameter=220}">
                <ListBox ItemsSource="{Binding Entries}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource Dyc.TextBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        BorderBrush="{DynamicResource Dyc.InputBorderBrush}"
                                        BorderThickness="0,0,1,0"
                                        Padding="0,0,6,0"
                                        Margin="0,0,6,0"
                                        Visibility="{Binding HasIndex, Converter={StaticResource Dyc.BoolToVisibility}}">
                                    <TextBlock Text="{Binding Index}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               MinWidth="22"
                                               TextAlignment="Right"
                                               Foreground="{DynamicResource Dyc.AccentBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Text}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource Dyc.TextBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <views:SizeGripThumb Grid.Row="2"
                                 HorizontalAlignment="Right"
                                 Width="14"
                                 Height="12"
                                 Margin="0,2,0,0"
                                 ToolTip="Drag to resize"
                                 TargetElement="{Binding ElementName=WatchListBox}"
                                 TargetWidth="{Binding DataContext.WatchWidth, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}, Mode=TwoWay}"
                                 TargetHeight="{Binding DataContext.WatchHeight, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}, Mode=TwoWay}"
                                 MinTargetWidth="140"
                                 MinTargetHeight="24">
                <views:SizeGripThumb.Template>
                    <ControlTemplate TargetType="{x:Type views:SizeGripThumb}">
                        <Grid Background="Transparent">
                            <Path Data="M 12,2 L 2,12 M 12,7 L 7,12"
                                  Stroke="{DynamicResource Dyc.SubtleTextBrush}"
                                  StrokeThickness="1.5" />
                        </Grid>
                    </ControlTemplate>
                </views:SizeGripThumb.Template>
            </views:SizeGripThumb>
        </Grid>
    </DataTemplate>

    <!-- Watch Table: the table as a grid. Equal-width columns (a UniformGrid per line), the header on top, the rows in a virtualized list. -->
    <DataTemplate x:Key="NodeBody.WatchTableNode">
        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Margin="1,0,1,3"
                       FontSize="10"
                       Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                       Text="{Binding Summary}" />
            <Border x:Name="WatchTableBox"
                    Grid.Row="1"
                    Background="{DynamicResource Dyc.InputBackgroundBrush}"
                    BorderBrush="{DynamicResource Dyc.InputBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="6,3"
                    MinWidth="180"
                    MinHeight="40"
                    Width="{Binding DataContext.WatchWidth, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}}"
                    Height="{Binding DataContext.WatchHeight, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}}"
                    MaxWidth="{Binding DataContext.WatchWidth, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}, Converter={StaticResource Dyc.AutoSizeLimit}, ConverterParameter=520}"
                    MaxHeight="{Binding DataContext.WatchHeight, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}, Converter={StaticResource Dyc.AutoSizeLimit}, ConverterParameter=260}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ItemsControl Grid.Row="0"
                                  ItemsSource="{Binding Headers}"
                                  Focusable="False"
                                  IsTabStop="False"
                                  Margin="0,0,0,2">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           ToolTip="{Binding}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,10,0"
                                           Foreground="{DynamicResource Dyc.AccentBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Rows}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource Dyc.TextBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Cells}" Focusable="False" IsTabStop="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       ToolTip="{Binding}"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,10,0"
                                                       Foreground="{DynamicResource Dyc.TextBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <views:SizeGripThumb Grid.Row="2"
                                 HorizontalAlignment="Right"
                                 Width="14"
                                 Height="12"
                                 Margin="0,2,0,0"
                                 ToolTip="Drag to resize"
                                 TargetElement="{Binding ElementName=WatchTableBox}"
                                 TargetWidth="{Binding DataContext.WatchWidth, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}, Mode=TwoWay}"
                                 TargetHeight="{Binding DataContext.WatchHeight, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}, Mode=TwoWay}"
                                 MinTargetWidth="180"
                                 MinTargetHeight="40">
                <views:SizeGripThumb.Template>
                    <ControlTemplate TargetType="{x:Type views:SizeGripThumb}">
                        <Grid Background="Transparent">
                            <Path Data="M 12,2 L 2,12 M 12,7 L 7,12"
                                  Stroke="{DynamicResource Dyc.SubtleTextBrush}"
                                  StrokeThickness="1.5" />
                        </Grid>
                    </ControlTemplate>
                </views:SizeGripThumb.Template>
            </views:SizeGripThumb>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="NodeBody.ListCreateNode">
        <StackPanel Orientation="Horizontal" Margin="4" HorizontalAlignment="Right">
            <Button Style="{StaticResource Dyc.SmallButton}"
                    Content="+"
                    ToolTip="Add item port"
                    Command="{Binding DataContext.AddPortCommand, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}}" />
            <Button Style="{StaticResource Dyc.SmallButton}"
                    Margin="4,0,0,0"
                    Content="−"
                    ToolTip="Remove last item port"
                    Command="{Binding DataContext.RemovePortCommand, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}}" />
        </StackPanel>
    </DataTemplate>

    <!-- Colour Picker: the swatch opens the full picker; the four channels are scrub fields like every other number in a node. -->
    <DataTemplate x:Key="NodeBody.ColorPickerNode">
        <StackPanel Margin="4" MinWidth="180">
            <views:ColorSwatchPicker Height="26"
                                     A="{Binding A, Mode=TwoWay}"
                                     R="{Binding R, Mode=TwoWay}"
                                     G="{Binding G, Mode=TwoWay}"
                                     B="{Binding B, Mode=TwoWay}" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <views:ScrubNumberBox Grid.Row="0" Grid.Column="0" Margin="0,0,2,2"
                                      Label="R" Minimum="0" Maximum="255" Step="1" IsInteger="True"
                                      Value="{Binding R, Mode=TwoWay}"
                                      LiveCommit="{Binding DataContext.LiveScrubEvaluation, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      PixelsPerStep="{Binding DataContext.ScrubPixelsPerStep, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      ToolTip="R channel (0-255). Drag, click to type, or double-click to reset." />
                <views:ScrubNumberBox Grid.Row="0" Grid.Column="1" Margin="2,0,0,2"
                                      Label="G" Minimum="0" Maximum="255" Step="1" IsInteger="True"
                                      Value="{Binding G, Mode=TwoWay}"
                                      LiveCommit="{Binding DataContext.LiveScrubEvaluation, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      PixelsPerStep="{Binding DataContext.ScrubPixelsPerStep, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      ToolTip="G channel (0-255). Drag, click to type, or double-click to reset." />
                <views:ScrubNumberBox Grid.Row="1" Grid.Column="0" Margin="0,0,2,2"
                                      Label="B" Minimum="0" Maximum="255" Step="1" IsInteger="True"
                                      Value="{Binding B, Mode=TwoWay}"
                                      LiveCommit="{Binding DataContext.LiveScrubEvaluation, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      PixelsPerStep="{Binding DataContext.ScrubPixelsPerStep, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      ToolTip="B channel (0-255). Drag, click to type, or double-click to reset." />
                <views:ScrubNumberBox Grid.Row="1" Grid.Column="1" Margin="2,0,0,2"
                                      Label="A" Minimum="0" Maximum="255" Step="1" IsInteger="True"
                                      Value="{Binding A, Mode=TwoWay}"
                                      LiveCommit="{Binding DataContext.LiveScrubEvaluation, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      PixelsPerStep="{Binding DataContext.ScrubPixelsPerStep, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      ToolTip="A channel (0-255). Drag, click to type, or double-click to reset." />
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!-- Group Input / Group Output: one button adds a socket to the group's interface; right-click a socket to rename, retype, move or remove it. -->
    <DataTemplate x:Key="NodeBody.GroupInterface">
        <Button Style="{StaticResource Dyc.SmallButton}"
                Margin="4,2"
                HorizontalAlignment="Stretch"
                Content="{Binding DataContext.AddSocketLabel, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}}"
                ToolTip="Add a socket to this node group's interface"
                Command="{Binding DataContext.AddGroupSocketCommand, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}}" />
    </DataTemplate>

    <DataTemplate x:Key="NodeBody.CapturedSelectionNode">
        <StackPanel Margin="4" MinWidth="180">
            <TextBlock Text="{Binding CapturedSummary}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Dyc.SubtleTextBrush}" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Dyc.SmallButton}"
                        Content="Capture"
                        ToolTip="Store the current Navisworks selection in this node"
                        Command="{Binding DataContext.CaptureSelectionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        CommandParameter="{Binding}" />
                <Button Style="{StaticResource Dyc.SmallButton}"
                        Margin="6,0,0,0"
                        Content="Clear"
                        ToolTip="Forget the stored selection"
                        Command="{Binding DataContext.ClearCapturedSelectionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        CommandParameter="{Binding}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Watch Image: renders the picture at the incoming file path inline.
         The (path, version) MultiBinding reloads the bitmap when a run
         overwrites the same file; the size grip resizes like the Watch nodes. -->
    <DataTemplate x:Key="NodeBody.WatchImageNode">
        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="{DynamicResource Dyc.InputBackgroundBrush}"
                    BorderBrush="{DynamicResource Dyc.InputBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="3">
                <Grid>
                    <Image x:Name="WatchImageBox"
                           Stretch="Uniform"
                           MinWidth="160"
                           MinHeight="60"
                           Width="{Binding DataContext.WatchWidth, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}}"
                           Height="{Binding DataContext.WatchHeight, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}}"
                           MaxWidth="{Binding DataContext.WatchWidth, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}, Converter={StaticResource Dyc.AutoSizeLimit}, ConverterParameter=320}"
                           MaxHeight="{Binding DataContext.WatchHeight, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}, Converter={StaticResource Dyc.AutoSizeLimit}, ConverterParameter=260}"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource Dyc.ImagePathToSource}">
                                <Binding Path="ImagePath" />
                                <Binding Path="ImageVersion" />
                            </MultiBinding>
                        </Image.Source>
                    </Image>
                    <TextBlock x:Name="NoImageHint"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="12,20"
                               FontSize="11"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="200"
                               Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                               Text="Wire an image path in and run — the picture shows here."
                               Visibility="Collapsed" />
                </Grid>
            </Border>
            <TextBlock Grid.Row="1"
                       Margin="1,3,1,0"
                       FontSize="10"
                       Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="320"
                       Text="{Binding FileName}"
                       ToolTip="{Binding ImagePath}"
                       Visibility="{Binding HasImage, Converter={StaticResource Dyc.BoolToVisibility}}" />
            <views:SizeGripThumb Grid.Row="2"
                                 HorizontalAlignment="Right"
                                 Width="14"
                                 Height="12"
                                 Margin="0,2,0,0"
                                 ToolTip="Drag to resize"
                                 TargetElement="{Binding ElementName=WatchImageBox}"
                                 TargetWidth="{Binding DataContext.WatchWidth, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}, Mode=TwoWay}"
                                 TargetHeight="{Binding DataContext.WatchHeight, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}, Mode=TwoWay}"
                                 MinTargetWidth="160"
                                 MinTargetHeight="60">
                <views:SizeGripThumb.Template>
                    <ControlTemplate TargetType="{x:Type views:SizeGripThumb}">
                        <Grid Background="Transparent">
                            <Path Data="M 12,2 L 2,12 M 12,7 L 7,12"
                                  Stroke="{DynamicResource Dyc.SubtleTextBrush}"
                                  StrokeThickness="1.5" />
                        </Grid>
                    </ControlTemplate>
                </views:SizeGripThumb.Template>
            </views:SizeGripThumb>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasImage}" Value="False">
                <Setter TargetName="NoImageHint" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ===== Canvas item templates (implicit, picked by view-model type) ===== -->
    <!-- ==================================================================
         ROW LAYOUT (Blender-style nodes)
         A node is a stack of rows: header, outputs (socket on the right edge),
         the node's own body, inputs (socket on the left edge, label and inline
         editor beside it), foldable panels, and a "+N hidden" chip. Sockets
         straddle the card edge (centre on the card outline, 9px in from the
         item container: 7px margin + 2px state border); the card sits inside that margin so the
         overflowing half of each socket stays inside the item container.
         ================================================================== -->

    <!-- The socket glyph: colour = data family, shape = structure. Filled when
         wired or required, a hollow ring when optional and unwired. -->
    <ControlTemplate x:Key="Dyc.SocketTemplate" TargetType="{x:Type Control}">
        <!-- Height follows the socket: 14 normally, as tall as the wires it carries for a multi-input pill. -->
        <Grid Width="14" Height="{Binding SocketHeight}" Background="Transparent" SnapsToDevicePixels="True">
            <Border x:Name="HoverRing"
                    Width="14"
                    CornerRadius="7"
                    BorderBrush="{DynamicResource Dyc.AccentBrush}"
                    BorderThickness="1.5"
                    Visibility="Collapsed" />
            <Path x:Name="Filled"
                  Data="{Binding SocketGeometry}"
                  Fill="{Binding FamilyBrush}"
                  Stroke="{DynamicResource Dyc.SocketOutlineBrush}"
                  StrokeThickness="1"
                  Stretch="None"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Opacity="{Binding SocketOpacity}" />
            <TextBlock x:Name="Glyph"
                       Text="{Binding SocketGlyph}"
                       FontSize="8"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Dyc.NodeBodyBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False" />
            <Path x:Name="Hollow"
                  Data="{Binding SocketGeometry}"
                  Fill="Transparent"
                  Stroke="{Binding FamilyBrush}"
                  StrokeThickness="1.6"
                  Stretch="None"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Opacity="{Binding SocketOpacity}"
                  Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsHollow}" Value="True">
                <Setter TargetName="Filled" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Hollow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HoverRing" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Sockets are Nodify connectors whose template is only the glyph (named
         PART_Connector, which Nodify measures to compute the wire anchor); the
         label and editor live in the row beside them. -->
    <Style x:Key="Dyc.Socket.Input" TargetType="{x:Type nodify:NodeInput}">
        <Setter Property="IsConnected" Value="{Binding IsConnected}" />
        <Setter Property="Anchor" Value="{Binding Anchor, Mode=OneWayToSource}" />
        <Setter Property="ToolTip" Value="{Binding ToolTip}" />
        <Setter Property="ConnectorTemplate" Value="{StaticResource Dyc.SocketTemplate}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type nodify:NodeInput}">
                    <Control x:Name="PART_Connector"
                             Focusable="False"
                             Background="Transparent"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Template="{TemplateBinding ConnectorTemplate}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem Header="Disconnect" Command="{Binding DisconnectCommand}" />
                    <MenuItem Header="Reset to Default" Command="{Binding ResetCommand}" InputGestureText="Backspace over a field" />
                    <Separator />
                    <MenuItem Header="List Levels">
                        <MenuItem Header="Use Levels"
                                  IsCheckable="True"
                                  IsChecked="{Binding UseLevels}" />
                        <Separator />
                        <MenuItem Header="@L1 — items"
                                  Command="{Binding SetLevelCommand}" CommandParameter="1"
                                  IsChecked="{Binding IsLevel1, Mode=OneWay}" />
                        <MenuItem Header="@L2 — lists of items"
                                  Command="{Binding SetLevelCommand}" CommandParameter="2"
                                  IsChecked="{Binding IsLevel2, Mode=OneWay}" />
                        <MenuItem Header="@L3"
                                  Command="{Binding SetLevelCommand}" CommandParameter="3"
                                  IsChecked="{Binding IsLevel3, Mode=OneWay}" />
                        <MenuItem Header="@L4"
                                  Command="{Binding SetLevelCommand}" CommandParameter="4"
                                  IsChecked="{Binding IsLevel4, Mode=OneWay}" />
                        <Separator />
                        <MenuItem Header="Keep list structure"
                                  IsCheckable="True"
                                  IsChecked="{Binding KeepListStructure}" />
                    </MenuItem>
                </ContextMenu>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dyc.Socket.Output" TargetType="{x:Type nodify:NodeOutput}">
        <Setter Property="IsConnected" Value="{Binding IsConnected}" />
        <Setter Property="Anchor" Value="{Binding Anchor, Mode=OneWayToSource}" />
        <Setter Property="ToolTip" Value="{Binding ToolTip}" />
        <Setter Property="ConnectorTemplate" Value="{StaticResource Dyc.SocketTemplate}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type nodify:NodeOutput}">
                    <Control x:Name="PART_Connector"
                             Focusable="False"
                             Background="Transparent"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Template="{TemplateBinding ConnectorTemplate}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem Header="Disconnect" Command="{Binding DisconnectCommand}" />
                </ContextMenu>
            </Setter.Value>
        </Setter>
    </Style>

    <views:NodeRowTemplateSelector x:Key="Dyc.RowSelector" />

    <Style x:Key="Dyc.NodeChevronButton" TargetType="{x:Type Button}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="Transparent" Padding="2,0,6,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Inline input editors (an unwired input is its own editor) ===== -->
    <Style TargetType="{x:Type views:ScrubNumberBox}">
        <Setter Property="FieldBrush" Value="{DynamicResource Dyc.InputBackgroundBrush}" />
        <Setter Property="HoverBrush" Value="{DynamicResource Dyc.HoverBrush}" />
        <Setter Property="FillBrush" Value="{DynamicResource Dyc.AccentBrush}" />
        <Setter Property="TextBrush" Value="{DynamicResource Dyc.TextBrush}" />
        <Setter Property="SubtleBrush" Value="{DynamicResource Dyc.SubtleTextBrush}" />
        <Setter Property="AccentBrush" Value="{DynamicResource Dyc.AccentBrush}" />
        <Setter Property="ErrorBrush" Value="{DynamicResource Dyc.ErrorBrush}" />
    </Style>

    <Style x:Key="Dyc.NodeCheckBox" TargetType="{x:Type CheckBox}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border x:Name="Box"
                            Width="30" Height="16"
                            CornerRadius="8"
                            Background="{DynamicResource Dyc.InputBackgroundBrush}"
                            BorderBrush="{DynamicResource Dyc.InputBorderBrush}"
                            BorderThickness="1">
                        <Ellipse x:Name="Knob"
                                 Width="10" Height="10"
                                 HorizontalAlignment="Left"
                                 Margin="3,0,0,0"
                                 Fill="{DynamicResource Dyc.SubtleTextBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Dyc.AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            <Setter TargetName="Knob" Property="Fill" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented buttons for two or three short choices (no popup needed). -->
    <Style x:Key="Dyc.SegmentedListBox" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ListBoxItem}">
                    <!-- Must stay focusable: ListBoxItem only selects on click when it can take focus. -->
                    <Setter Property="Focusable" Value="True" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Border x:Name="Seg"
                                        Height="20"
                                        Margin="0,0,1,0"
                                        Background="{DynamicResource Dyc.InputBackgroundBrush}"
                                        CornerRadius="3">
                                    <TextBlock Text="{Binding}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Dyc.TextBrush}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Seg" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Seg" Property="Background" Value="{DynamicResource Dyc.AccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vertical section list of the Settings page. -->
    <Style x:Key="Dyc.NavListBox" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Focusable" Value="True" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Border x:Name="Nav"
                                        Padding="12,7"
                                        Margin="0,1"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="2,0,0,0"
                                        CornerRadius="3">
                                    <TextBlock Text="{Binding}"
                                               FontSize="13"
                                               Foreground="{DynamicResource Dyc.TextBrush}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Nav" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Nav" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                                        <Setter TargetName="Nav" Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Editor.Number">
        <views:ScrubNumberBox Label="{Binding Title}"
                              Value="{Binding NumberValue, Mode=TwoWay}"
                              Minimum="{Binding NumberMin}"
                              Maximum="{Binding NumberMax}"
                              SoftMinimum="{Binding NumberSoftMin}"
                              SoftMaximum="{Binding NumberSoftMax}"
                              Step="{Binding NumberStep}"
                              IsInteger="{Binding NumberIsInteger}"
                              Unit="{Binding NumberUnit}"
                              IsModified="{Binding IsModified}"
                              IsUnset="{Binding IsUnset}"
                              ResetCommand="{Binding ResetCommand}"
                              LiveCommit="{Binding DataContext.LiveScrubEvaluation, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                              PixelsPerStep="{Binding DataContext.ScrubPixelsPerStep, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                              ToolTip="{Binding ToolTip}" />
    </DataTemplate>

    <DataTemplate x:Key="Editor.Toggle">
        <CheckBox Style="{StaticResource Dyc.NodeCheckBox}" IsChecked="{Binding BoolValue, Mode=TwoWay}" ToolTip="{Binding ToolTip}" />
    </DataTemplate>

    <DataTemplate x:Key="Editor.Dropdown">
        <ComboBox Style="{StaticResource Dyc.ComboBox}"
                  Height="20"
                  MinWidth="96"
                  ItemsSource="{Binding Choices}"
                  SelectedItem="{Binding SelectedChoice, Mode=TwoWay}" />
    </DataTemplate>

    <DataTemplate x:Key="Editor.Segmented">
        <ListBox Style="{StaticResource Dyc.SegmentedListBox}"
                 ItemsSource="{Binding Choices}"
                 SelectedItem="{Binding SelectedChoice, Mode=TwoWay}" />
    </DataTemplate>

    <DataTemplate x:Key="Editor.Text">
        <TextBox Style="{StaticResource Dyc.TextBox}"
                 Height="22"
                 MinWidth="60"
                 Padding="6,0"
                 FontSize="11"
                 VerticalContentAlignment="Center"
                 Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}"
                 ToolTip="{Binding ToolTip}" />
    </DataTemplate>

    <DataTemplate x:Key="Editor.Colour">
        <views:ColorSwatchPicker Hex="{Binding ColourHex, Mode=TwoWay}" />
    </DataTemplate>

    <Style x:Key="Dyc.ModelFieldButton" TargetType="{x:Type Button}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{DynamicResource Dyc.InputBackgroundBrush}"
                            BorderBrush="{DynamicResource Dyc.InputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Model-element input (Blender's object picker, for Navisworks items): pick the live selection, click the
         name to select the items again, redo the pick, or clear it. -->
    <DataTemplate x:Key="Editor.Model">
        <Grid Height="22">
            <Button x:Name="Empty"
                    Style="{StaticResource Dyc.ModelFieldButton}"
                    HorizontalContentAlignment="Left"
                    Command="{Binding CaptureModelCommand}"
                    ToolTip="Use the elements currently selected in Navisworks">
                <StackPanel Orientation="Horizontal">
                    <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"
                          Fill="{DynamicResource Dyc.SubtleTextBrush}"
                          Data="{StaticResource Dyc.Icon.Pick}" />
                    <TextBlock Text="Pick from selection" Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                </StackPanel>
            </Button>
            <Grid x:Name="Filled" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Style="{StaticResource Dyc.ModelFieldButton}"
                        HorizontalContentAlignment="Left"
                        Command="{Binding RevealModelCommand}"
                        ToolTip="{Binding ModelSummary}">
                    <TextBlock Text="{Binding ModelSummary}" TextTrimming="CharacterEllipsis" />
                </Button>
                <Button Grid.Column="1"
                        Style="{StaticResource Dyc.ModelFieldButton}"
                        Width="24" Margin="3,0,0,0"
                        HorizontalContentAlignment="Center"
                        Command="{Binding CaptureModelCommand}"
                        ToolTip="Pick again from the current selection">
                    <Path Width="12" Height="12" Stretch="Uniform"
                          Fill="{DynamicResource Dyc.SubtleTextBrush}"
                          Data="{StaticResource Dyc.Icon.Pick}" />
                </Button>
                <Button Grid.Column="2"
                        Style="{StaticResource Dyc.ModelFieldButton}"
                        Width="24" Margin="3,0,0,0"
                        HorizontalContentAlignment="Center"
                        Command="{Binding ResetCommand}"
                        ToolTip="Clear">
                    <TextBlock Text="✕" FontSize="10" Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                </Button>
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasModelValue}" Value="True">
                <Setter TargetName="Empty" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Filled" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="Editor.Path">
        <DockPanel>
            <Button DockPanel.Dock="Right"
                    Content="…"
                    Width="22" Height="22"
                    Margin="3,0,0,0"
                    Focusable="False"
                    Command="{Binding BrowseCommand}"
                    Style="{StaticResource Dyc.SmallButton}"
                    ToolTip="Browse" />
            <TextBox Style="{StaticResource Dyc.TextBox}"
                     Height="22"
                     Padding="6,0"
                     FontSize="11"
                     VerticalContentAlignment="Center"
                     Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}"
                     ToolTip="{Binding TextValue}" />
        </DockPanel>
    </DataTemplate>

    <!-- Hosts the right editor for a row's connector; collapsed (and never instantiated) when there is none or a wire feeds the input. -->
    <Style x:Key="Dyc.EditorHost" TargetType="{x:Type ContentControl}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Connector.ShowEditor}" Value="True" />
                    <Condition Binding="{Binding Connector.EditorKind}" Value="Number" />
                </MultiDataTrigger.Conditions>
                <Setter Property="ContentTemplate" Value="{StaticResource Editor.Number}" />
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Connector.ShowEditor}" Value="True" />
                    <Condition Binding="{Binding Connector.EditorKind}" Value="Toggle" />
                </MultiDataTrigger.Conditions>
                <Setter Property="ContentTemplate" Value="{StaticResource Editor.Toggle}" />
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Connector.ShowEditor}" Value="True" />
                    <Condition Binding="{Binding Connector.EditorKind}" Value="Text" />
                </MultiDataTrigger.Conditions>
                <Setter Property="ContentTemplate" Value="{StaticResource Editor.Text}" />
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Connector.ShowEditor}" Value="True" />
                    <Condition Binding="{Binding Connector.EditorKind}" Value="Colour" />
                </MultiDataTrigger.Conditions>
                <Setter Property="ContentTemplate" Value="{StaticResource Editor.Colour}" />
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Connector.ShowEditor}" Value="True" />
                    <Condition Binding="{Binding Connector.EditorKind}" Value="Model" />
                </MultiDataTrigger.Conditions>
                <Setter Property="ContentTemplate" Value="{StaticResource Editor.Model}" />
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Connector.ShowEditor}" Value="True" />
                    <Condition Binding="{Binding Connector.EditorKind}" Value="Path" />
                </MultiDataTrigger.Conditions>
                <Setter Property="ContentTemplate" Value="{StaticResource Editor.Path}" />
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding Connector.ShowDropdownChoices}" Value="True">
                <Setter Property="ContentTemplate" Value="{StaticResource Editor.Dropdown}" />
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Connector.ShowSegmentedChoices}" Value="True">
                <Setter Property="ContentTemplate" Value="{StaticResource Editor.Segmented}" />
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== The Script Player's fields =====
         The Player has room the node editor does not: its fields are taller, and a text field wraps and grows with its text
         (up to a limit, then it scrolls) instead of cutting a long or multi-line value off at one line. Same view models and
         bindings as the node editors; only the templates differ. -->
