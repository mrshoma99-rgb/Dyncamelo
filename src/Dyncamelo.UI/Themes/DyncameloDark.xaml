                    <Path Width="13" Height="13" Stretch="Uniform"
                          Fill="{DynamicResource Dyc.SubtleTextBrush}"
                          Data="{StaticResource Dyc.Icon.Pick}" />
                </Button>
                <Button Grid.Column="2"
                        Style="{StaticResource Dyc.ModelFieldButton}"
                        Width="28" Margin="4,0,0,0"
                        HorizontalContentAlignment="Center"
                        Command="{Binding ResetCommand}"
                        ToolTip="Clear">
                    <TextBlock Text="✕" FontSize="10" Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                </Button>
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasModelValue}" Value="True">
                <Setter TargetName="Empty" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Filled" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The editor host for the Player: the node editor's, with the roomy templates above. -->
    <Style x:Key="Dyc.PlayerEditorHost" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Dyc.EditorHost}">
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Connector.ShowEditor}" Value="True" />
                    <Condition Binding="{Binding Connector.EditorKind}" Value="Number" />
                </MultiDataTrigger.Conditions>
                <Setter Property="ContentTemplate" Value="{StaticResource PlayerEditor.Number}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Connector.ShowEditor}" Value="True" />
                    <Condition Binding="{Binding Connector.EditorKind}" Value="Text" />
                </MultiDataTrigger.Conditions>
                <Setter Property="ContentTemplate" Value="{StaticResource PlayerEditor.Text}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Connector.ShowEditor}" Value="True" />
                    <Condition Binding="{Binding Connector.EditorKind}" Value="Path" />
                </MultiDataTrigger.Conditions>
                <Setter Property="ContentTemplate" Value="{StaticResource PlayerEditor.Path}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Connector.ShowEditor}" Value="True" />
                    <Condition Binding="{Binding Connector.EditorKind}" Value="Model" />
                </MultiDataTrigger.Conditions>
                <Setter Property="ContentTemplate" Value="{StaticResource PlayerEditor.Model}" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding Connector.ShowDropdownChoices}" Value="True">
                <Setter Property="ContentTemplate" Value="{StaticResource PlayerEditor.Dropdown}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Row.Output">
        <Grid MinHeight="{Binding RowMinHeight}" Height="{Binding RowHeight}">
            <TextBlock Text="{Binding Connector.Title}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="10,0,14,0"
                       FontSize="11"
                       Foreground="{DynamicResource Dyc.TextBrush}"
                       Visibility="{Binding ShowContent, Converter={StaticResource Dyc.BoolToVisibility}}" />
            <nodify:NodeOutput DataContext="{Binding Connector}"
                               Style="{StaticResource Dyc.Socket.Output}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,-9,0" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Row.Input">
        <Grid MinHeight="{Binding RowMinHeight}" Height="{Binding RowHeight}">
            <nodify:NodeInput DataContext="{Binding Connector}"
                              Style="{StaticResource Dyc.Socket.Input}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Margin="-9,0,0,0" />
            <Grid Margin="14,1,10,1"
                  VerticalAlignment="Center"
                  Visibility="{Binding ShowContent, Converter={StaticResource Dyc.BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Connector.Title}"
                               Margin="0,0,8,0"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Dyc.TextBrush}"
                               Visibility="{Binding Connector.ShowPlainLabel, Converter={StaticResource Dyc.BoolToVisibility}}" />
                    <TextBlock Text="{Binding Connector.LevelLabel}"
                               Margin="0,0,6,0"
                               FontSize="10"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Dyc.AccentBrush}"
                               ToolTip="This input consumes the incoming list at this level (right-click the socket to change)."
                               Visibility="{Binding Connector.HasLevels, Converter={StaticResource Dyc.BoolToVisibility}}" />
                </StackPanel>
                <ContentControl Grid.Column="1"
                                Style="{StaticResource Dyc.EditorHost}"
                                Content="{Binding Connector}" />
            </Grid>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Row.Body">
        <ContentControl Focusable="False"
                        Margin="6,2"
                        Content="{Binding Node.Model}"
                        ContentTemplateSelector="{StaticResource Dyc.NodeBodySelector}"
                        Visibility="{Binding ShowContent, Converter={StaticResource Dyc.BoolToVisibility}}" />
    </DataTemplate>

    <DataTemplate x:Key="Row.PanelHeader">
        <Border MinHeight="{Binding RowMinHeight}"
                Height="{Binding RowHeight}"
                Background="Transparent"
                Cursor="Hand"
                ToolTip="Click to expand or collapse"
                Visibility="{Binding ShowContent, Converter={StaticResource Dyc.BoolToVisibility}}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding TogglePanelCommand}" />
            </Border.InputBindings>
            <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                <TextBlock x:Name="Chevron"
                           Text="▸"
                           Width="14"
                           FontSize="11"
                           Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                <TextBlock Text="{Binding Panel}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                <TextBlock Text="{Binding CountText}"
                           Margin="6,0,0,0"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Dyc.AccentBrush}"
                           Visibility="{Binding HasCount, Converter={StaticResource Dyc.BoolToVisibility}}" />
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                <Setter TargetName="Chevron" Property="Text" Value="▾" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="Row.Hidden">
        <Border MinHeight="{Binding RowMinHeight}"
                Height="{Binding RowHeight}"
                Background="Transparent"
                Cursor="Hand"
                ToolTip="Show the hidden sockets"
                Visibility="{Binding ShowContent, Converter={StaticResource Dyc.BoolToVisibility}}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding RevealCommand}" />
            </Border.InputBindings>
            <TextBlock Text="{Binding HiddenText}"
                       Margin="14,0"
                       VerticalAlignment="Center"
                       FontSize="10"
                       Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
        </Border>
    </DataTemplate>

    <!-- The card. Structure: [balloon] / root grid { width grip, state border { card { header, rows } } } / preview bubble. -->
    <DataTemplate x:Key="Dyc.NodeTemplate.Blender">
        <StackPanel>
            <Canvas Height="0" HorizontalAlignment="Left">
                <Border x:Name="Balloon"
                        Canvas.Bottom="8"
                        Canvas.Left="7"
                        Visibility="Collapsed"
                        MaxWidth="300"
                        CornerRadius="4"
                        Padding="8,5"
                        BorderThickness="1.5"
                        Background="{DynamicResource Dyc.PanelBrush}"
                        BorderBrush="{DynamicResource Dyc.WarningBrush}">
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource Dyc.TextBrush}"
                               TextWrapping="Wrap"
                               MaxHeight="120"
                               Text="{Binding StateMessage}"
                               ToolTip="{Binding StateMessage}" />
                </Border>
            </Canvas>
            <Grid x:Name="NodeRoot" Width="{Binding NodeWidth}" MinWidth="154">
                <views:NodeWidthGrip x:Name="WidthGrip"
                                     Target="{Binding ElementName=NodeRoot}"
                                     Margin="0,26,0,0"
                                     ToolTip="Drag to resize · double-click for automatic width" />
                <Border x:Name="StateBorder"
                        Margin="7,0"
                        BorderThickness="2"
                        BorderBrush="Transparent"
                        CornerRadius="8"
                        Background="Transparent">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Collapse / Expand" InputGestureText="H" Command="{Binding ToggleCollapseCommand}" />
                            <MenuItem Header="Mute / Unmute" InputGestureText="M" Command="{Binding ToggleMuteCommand}"
                                      ToolTip="Skip this node but keep the data flowing: each output passes the matching input straight through, and everything downstream still runs." />
                            <MenuItem Header="Hide / Show Unused Sockets" InputGestureText="Ctrl+H" Command="{Binding ToggleHideUnusedCommand}" />
                            <MenuItem Header="Reset Width" Command="{Binding ResetWidthCommand}" />
                            <Separator />
                            <MenuItem Header="Freeze / Unfreeze" InputGestureText="Shift+M" Command="{Binding ToggleFreezeCommand}"
                                      ToolTip="Stop this node and everything downstream of it from running. They keep their last results until unfrozen." />
                            <MenuItem Header="Show Preview"
                                      IsCheckable="True"
                                      IsChecked="{Binding ShowPreview}" />
                            <MenuItem Header="Lacing">
                                <MenuItem Header="Auto" Command="{Binding SetLacingCommand}" CommandParameter="Auto" />
                                <MenuItem Header="Shortest" Command="{Binding SetLacingCommand}" CommandParameter="Shortest" />
                                <MenuItem Header="Longest" Command="{Binding SetLacingCommand}" CommandParameter="Longest" />
                                <MenuItem Header="Cross Product" Command="{Binding SetLacingCommand}" CommandParameter="CrossProduct" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Find in Library" Command="{Binding FindInLibraryCommand}" />
                            <Separator Visibility="{Binding IsGroupInstance, Converter={StaticResource Dyc.BoolToVisibility}}" />
                            <MenuItem Header="Open Node Group" InputGestureText="Tab" Command="{Binding EnterGroupCommand}"
                                      Visibility="{Binding IsGroupInstance, Converter={StaticResource Dyc.BoolToVisibility}}" />
                            <MenuItem Header="Ungroup" InputGestureText="Ctrl+Alt+U" Command="{Binding UngroupCommand}"
                                      Visibility="{Binding IsGroupInstance, Converter={StaticResource Dyc.BoolToVisibility}}" />
                            <MenuItem Header="Rename Node Group…" Command="{Binding RenameGroupCommand}"
                                      Visibility="{Binding IsGroupInstance, Converter={StaticResource Dyc.BoolToVisibility}}" />
                            <MenuItem Header="Make Single User" Command="{Binding MakeSingleUserCommand}"
                                      ToolTip="Give this instance its own copy of the group, so editing it no longer changes the other instances."
                                      Visibility="{Binding IsGroupInstance, Converter={StaticResource Dyc.BoolToVisibility}}" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Border x:Name="Card"
                            Background="{DynamicResource Dyc.NodeBodyBrush}"
                            BorderBrush="{DynamicResource Dyc.NodeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Header: collapse chevron, function dot, editable title, lacing, mute badge. Collapsed, the header is the
                                 whole node (a capsule in the category colour) and the socket rows are drawn over it. -->
                            <Border x:Name="Header"
                                    Grid.Row="0"
                                    Background="{Binding HeaderBrush}"
                                    CornerRadius="5,5,0,0"
                                    MinHeight="26"
                                    Padding="6,0,8,0">
                                <DockPanel VerticalAlignment="Center">
                                    <Button DockPanel.Dock="Left"
                                            Style="{StaticResource Dyc.NodeChevronButton}"
                                            Command="{Binding ToggleCollapseCommand}"
                                            ToolTip="Collapse / expand (H)">
                                        <TextBlock x:Name="Chevron" Text="▾" FontSize="11" Foreground="White" />
                                    </Button>
                                    <Button x:Name="EnterGroupButton"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource Dyc.NodeChevronButton}"
                                            Margin="6,0,0,0"
                                            Command="{Binding EnterGroupCommand}"
                                            Visibility="Collapsed"
                                            ToolTip="Open this node group to edit it (Tab)">
                                        <Path Width="12" Height="12" Stretch="Uniform" Fill="White" Data="{StaticResource Dyc.Icon.OpenGroup}" />
                                    </Button>
                                    <TextBlock x:Name="MuteBadge"
                                               DockPanel.Dock="Right"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Text="MUTED"
                                               ToolTip="Muted: not run. Outputs pass the matching inputs straight through, so the graph carries on downstream (M)."
                                               Visibility="Collapsed" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               Foreground="White"
                                               Text="▶"
                                               ToolTip="Shown in the Script Player: this node, or some of its inputs, is a field or a result of the script's form."
                                               Visibility="{Binding InPlayer, Converter={StaticResource Dyc.BoolToVisibility}}" />
                                    <TextBlock x:Name="FrozenBadge"
                                               DockPanel.Dock="Right"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Text="FROZEN"
                                               ToolTip="Frozen: this node and everything downstream keep their last results and are skipped by runs (Shift+M)."
                                               Visibility="Collapsed" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="9"
                                               Opacity="0.85"
                                               Foreground="White"
                                               Text="{Binding LacingLabel}" />
                                    <Ellipse x:Name="FnDot"
                                             DockPanel.Dock="Left"
                                             Width="10" Height="10"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center"
                                             Stroke="White"
                                             StrokeThickness="1.5"
                                             Fill="{DynamicResource Dyc.FnModifyBrush}"
                                             ToolTip="{Binding Function}" />
                                    <views:EditableTextBlock FontWeight="SemiBold"
                                                             Foreground="White"
                                                             Text="{Binding Title, Mode=TwoWay}"
                                                             ToolTip="{Binding Description}" />
                                </DockPanel>
                            </Border>
                            <ItemsControl x:Name="RowsHost"
                                          Grid.Row="1"
                                          ItemsSource="{Binding Rows}"
                                          ItemTemplateSelector="{StaticResource Dyc.RowSelector}"
                                          Focusable="False"
                                          IsTabStop="False"
                                          Padding="0,3" />
                        </Grid>
                    </Border>
                </Border>
            </Grid>
            <Border x:Name="PreviewBubble"
                    Margin="8,4,8,0"
                    HorizontalAlignment="Center"
                    MaxWidth="300"
                    CornerRadius="3"
                    Padding="6,3"
                    BorderThickness="1"
                    Background="{DynamicResource Dyc.PanelBrush}"
                    BorderBrush="{DynamicResource Dyc.PanelBorderBrush}"
                    Visibility="{Binding IsPreviewVisible, Converter={StaticResource Dyc.BoolToVisibility}}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding TogglePreviewExpandCommand}" />
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock x:Name="PreviewSummary"
                               FontSize="10"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding PreviewText}"
                               ToolTip="{Binding PreviewText}" />
                    <TextBox FontSize="10"
                             FontFamily="Consolas"
                             Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                             Background="Transparent"
                             BorderThickness="0"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             MaxHeight="240"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding ExpandedPreviewText, Mode=OneWay}"
                             Visibility="{Binding IsPreviewExpanded, Converter={StaticResource Dyc.BoolToVisibility}}" />
                    <TextBlock FontSize="9"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource Dyc.AccentBrush}"
                               Text="▸ click to show all items"
                               Visibility="{Binding ShowExpandHint, Converter={StaticResource Dyc.BoolToVisibility}}" />
                    <TextBlock FontSize="9"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource Dyc.AccentBrush}"
                               Text="▾ click to collapse"
                               Visibility="{Binding IsPreviewExpanded, Converter={StaticResource Dyc.BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                <Setter TargetName="Chevron" Property="Text" Value="▸" />
                <!-- Blender's hidden node: a capsule filled with the category colour, as wide as its title, the input sockets
                     down the left edge and the output sockets down the right edge. -->
                <Setter TargetName="NodeRoot" Property="Width" Value="NaN" />
                <Setter TargetName="NodeRoot" Property="MinWidth" Value="96" />
                <Setter TargetName="WidthGrip" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="StateBorder" Property="CornerRadius" Value="15" />
                <Setter TargetName="Card" Property="CornerRadius" Value="13" />
                <Setter TargetName="Card" Property="Background" Value="{Binding HeaderBrush}" />
                <Setter TargetName="Card" Property="BorderBrush" Value="{Binding HeaderBrush}" />
                <Setter TargetName="Header" Property="CornerRadius" Value="13" />
                <Setter TargetName="Header" Property="Background" Value="Transparent" />
                <Setter TargetName="Header" Property="Padding" Value="14,0,14,0" />
                <Setter TargetName="FnDot" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="RowsHost" Property="Grid.Row" Value="0" />
                <Setter TargetName="RowsHost" Property="Padding" Value="0" />
                <Setter TargetName="RowsHost" Property="Margin" Value="0,5" />
                <Setter TargetName="RowsHost" Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <views:CollapsedSocketPanel />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsGroupInstance}" Value="True">
                <Setter TargetName="EnterGroupButton" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                <Setter TargetName="MuteBadge" Property="Visibility" Value="Visible" />
                <Setter TargetName="StateBorder" Property="Opacity" Value="0.6" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Function}" Value="Create">
                <Setter TargetName="FnDot" Property="Fill" Value="{DynamicResource Dyc.FnCreateBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Function}" Value="Info">
                <Setter TargetName="FnDot" Property="Fill" Value="{DynamicResource Dyc.FnInfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPreviewExpanded}" Value="True">
                <Setter TargetName="PreviewSummary" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasMorePreview}" Value="True">
                <Setter TargetName="PreviewBubble" Property="Cursor" Value="Hand" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Warning">
                <Setter TargetName="StateBorder" Property="BorderBrush" Value="{DynamicResource Dyc.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Error">
                <Setter TargetName="StateBorder" Property="BorderBrush" Value="{DynamicResource Dyc.ErrorBrush}" />
                <Setter TargetName="Balloon" Property="BorderBrush" Value="{DynamicResource Dyc.ErrorBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasMessage}" Value="True">
                <Setter TargetName="StateBorder" Property="ToolTip" Value="{Binding StateMessage}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                <Setter TargetName="FrozenBadge" Property="Visibility" Value="Visible" />
                <Setter TargetName="StateBorder" Property="Opacity" Value="0.45" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding State}" Value="Warning" />
                    <Condition Binding="{Binding HasMessage}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Balloon" Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding State}" Value="Error" />
                    <Condition Binding="{Binding HasMessage}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Balloon" Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A wire waypoint: one input socket and one output socket side by side. -->
    <DataTemplate x:Key="Dyc.NodeTemplate.Reroute">
        <Grid Width="40" Height="22" Background="Transparent" ToolTip="Reroute — Delete removes it and keeps the wire">
            <Border Margin="6,3"
                    CornerRadius="8"
                    Background="{DynamicResource Dyc.NodeBodyBrush}"
                    BorderBrush="{DynamicResource Dyc.NodeBorderBrush}"
                    BorderThickness="1" />
            <nodify:NodeInput DataContext="{Binding Inputs[0]}"
                              Style="{StaticResource Dyc.Socket.Input}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Margin="4,0,0,0" />
            <nodify:NodeOutput DataContext="{Binding Outputs[0]}"
                               Style="{StaticResource Dyc.Socket.Output}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0" />
        </Grid>
    </DataTemplate>

    <!-- What the editor instantiates for every node: the row layout, or the reroute pill. -->
    <DataTemplate DataType="{x:Type vm:NodeViewModel}">
        <ContentControl x:Name="NodeHost"
                        Content="{Binding}"
                        Focusable="False"
                        IsTabStop="False"
                        ContentTemplate="{StaticResource Dyc.NodeTemplate.Blender}" />
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsReroute}" Value="True">
                <Setter TargetName="NodeHost" Property="ContentTemplate" Value="{StaticResource Dyc.NodeTemplate.Reroute}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ===== Groups (Dynamo-style: colored rectangle behind its nodes; dragging
         the header moves the members, the thumb resizes, title is editable) ===== -->
    <DataTemplate DataType="{x:Type vm:GroupViewModel}">
        <nodify:GroupingNode ActualSize="{Binding GroupSize, Mode=TwoWay}"
                             HeaderBrush="{Binding HeaderBrush}"
                             Background="{Binding BodyBrush}"
                             MovementMode="Group"
                             HorizontalContentAlignment="Stretch">
            <nodify:GroupingNode.Header>
                <Grid Background="Transparent" ToolTip="Drag the colored bar to move the group and its nodes">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="40" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             MinWidth="60"
                             MaxWidth="260"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             CaretBrush="White"
                             FontWeight="SemiBold"
                             ToolTip="Group title (click to edit)"
                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </nodify:GroupingNode.Header>
            <nodify:GroupingNode.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Ungroup" Command="{Binding UngroupCommand}" />
                    <MenuItem Header="Color">
                        <MenuItem Header="Blue" Command="{Binding SetColorCommand}" CommandParameter="#FF3D6A99" />
                        <MenuItem Header="Green" Command="{Binding SetColorCommand}" CommandParameter="#FF3F7249" />
                        <MenuItem Header="Amber" Command="{Binding SetColorCommand}" CommandParameter="#FF9A7B2D" />
                        <MenuItem Header="Red" Command="{Binding SetColorCommand}" CommandParameter="#FF8A3B3B" />
                        <MenuItem Header="Purple" Command="{Binding SetColorCommand}" CommandParameter="#FF6B4E8E" />
                        <MenuItem Header="Gray" Command="{Binding SetColorCommand}" CommandParameter="#FF5A6273" />
                    </MenuItem>
                </ContextMenu>
            </nodify:GroupingNode.ContextMenu>
        </nodify:GroupingNode>
    </DataTemplate>

    <!-- Notes are classic yellow stickies with fixed dark text: always readable on
         either canvas, and independent of the active palette (a palette-swapped
         note background could otherwise collide with the swapped text colour). -->
    <DataTemplate DataType="{x:Type vm:NoteViewModel}">
        <Border Background="#FFFCE9A6"
                BorderBrush="#FFE6C766"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8"
                MinWidth="140"
                MaxWidth="320">
            <TextBox Background="Transparent"
                     BorderThickness="0"
                     Foreground="#FF3A3320"
                     CaretBrush="#FF3A3320"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
        </Border>
    </DataTemplate>

</ResourceDictionary>
