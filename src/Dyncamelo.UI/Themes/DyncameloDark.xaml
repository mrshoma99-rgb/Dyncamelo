    <DataTemplate x:Key="PlayerEditor.Dropdown">
        <ComboBox Style="{StaticResource Dyc.ComboBox}"
                  Height="28"
                  FontSize="12"
                  ItemsSource="{Binding Choices}"
                  SelectedItem="{Binding SelectedChoice, Mode=TwoWay}" />
    </DataTemplate>

    <DataTemplate x:Key="PlayerEditor.Path">
        <DockPanel>
            <Button DockPanel.Dock="Right"
                    Content="…"
                    Width="28" Height="28"
                    Margin="4,0,0,0"
