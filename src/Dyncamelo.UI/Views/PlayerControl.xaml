<UserControl x:Class="Dyncamelo.UI.Views.PlayerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodify="https://miroiu.github.io/nodify"
             xmlns:vm="clr-namespace:Dyncamelo.UI.ViewModels"
             xmlns:views="clr-namespace:Dyncamelo.UI.Views"
             MinWidth="300"
             MinHeight="280">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Dyncamelo.UI;component/Themes/DyncameloDark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <CollectionViewSource x:Key="ScriptsView" Source="{Binding Scripts}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Folder" />
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel x:Name="LayoutRoot" Background="{DynamicResource Dyc.PanelBrush}">

        <!-- ===== Title bar ===== -->
        <Border DockPanel.Dock="Top" Height="34" Background="{DynamicResource Dyc.BrandBrush}">
            <DockPanel Margin="10,0">
                <Border DockPanel.Dock="Left"
                        Width="22" Height="22"
                        CornerRadius="6"
                        Background="{DynamicResource Dyc.LogoChipBrush}"
                        VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Dyncamelo.UI;component/Assets/camel_32.png"
                           Width="18" Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <TextBlock Text="Script Player"
                           Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Dyc.OnBrandBrush}"
                           FontWeight="SemiBold"
                           FontSize="13.5" />
                <TextBlock Text="runs a script without the node editor"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Dyc.OnBrandSubtleBrush}"
                           FontSize="10.5"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ===== Status line ===== -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Dyc.PanelBrush}"
                BorderBrush="{DynamicResource Dyc.PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,3"
                Visibility="{Binding HasStatus, Converter={StaticResource Dyc.BoolToVisibility}}">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                       TextWrapping="Wrap"
                       FontSize="11" />
        </Border>

        <!-- ===== Folders ===== -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource Dyc.PanelBorderBrush}"
                BorderThickness="0,1,0,0">
            <Expander IsExpanded="{Binding IsFoldersOpen, Mode=TwoWay}"
                      Foreground="{DynamicResource Dyc.TextBrush}"
                      Margin="8,4">
                <Expander.Header>
                    <TextBlock Text="Script folders" FontSize="11.5" Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                </Expander.Header>
                <StackPanel Margin="0,4,0,2">
                    <ItemsControl ItemsSource="{Binding Folders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource Dyc.SmallButton}"
                                            Content="✕"
                                            ToolTip="Take this folder off the list (the files stay)"
                                            Command="{Binding RemoveCommand}"
                                            Visibility="{Binding CanRemove, Converter={StaticResource Dyc.BoolToVisibility}}" />
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource Dyc.SmallButton}"
                                            Content="Open"
                                            Margin="0,0,4,0"
                                            ToolTip="Show the folder in Explorer"
                                            Command="{Binding OpenCommand}" />
                                    <TextBlock Text="{Binding Path}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="11"
                                               ToolTip="{Binding Path}"
                                               Foreground="{DynamicResource Dyc.TextBrush}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource Dyc.SmallButton}"
                            Content="Add a folder…"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,0"
                            Command="{Binding AddFolderCommand}" />
                </StackPanel>
            </Expander>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="90" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" MinHeight="120" />
            </Grid.RowDefinitions>

            <!-- ===== Script list ===== -->
            <DockPanel Grid.Row="0" Margin="8,8,8,4">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource Dyc.SmallButton}"
                            Margin="6,0,0,0"
                            Content="↻"
                            ToolTip="Look for scripts again"
                            Command="{Binding RefreshCommand}" />
                    <Grid>
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource Dyc.TextBox}"
                                 Padding="26,4,8,4"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Filter the scripts by name or folder" />
                        <Path Width="13" Height="13" Stretch="Uniform"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="8,0,0,0"
                              IsHitTestVisible="False"
                              Fill="{DynamicResource Dyc.SubtleTextBrush}"
                              Data="{StaticResource Dyc.Icon.Search}" />
                    </Grid>
                </DockPanel>

                <TextBlock Text="{Binding EmptyListText}"
                           Margin="2,6"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                           Visibility="{Binding IsListEmpty, Converter={StaticResource Dyc.BoolToVisibility}}" />

                <ListBox x:Name="ScriptList"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource Dyc.TextBrush}"
                         ItemsSource="{Binding Source={StaticResource ScriptsView}}"
                         SelectedItem="{Binding SelectedScript, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewKeyDown="OnScriptListKeyDown"
                         MouseDoubleClick="OnScriptListDoubleClick">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               Margin="2,8,0,2"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Border x:Name="Chrome"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="2,0,0,0"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="{DynamicResource Dyc.PanelBorderBrush}" />

            <!-- ===== The selected script ===== -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10,8,10,10">

                    <TextBlock Text="Pick a script above to see what it asks for, then press Run."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Dyc.SubtleTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasScript}" Value="False" />
                                            <Condition Binding="{Binding HasLoadError}" Value="False" />
                                            <Condition Binding="{Binding IsListEmpty}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding LoadError}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Dyc.ErrorBrush}"
                               Visibility="{Binding HasLoadError, Converter={StaticResource Dyc.BoolToVisibility}}" />

                    <StackPanel Visibility="{Binding HasScript, Converter={StaticResource Dyc.BoolToVisibility}}">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Dyc.TextBrush}" />
                        <TextBlock Text="{Binding Description}"
                                   Margin="0,3,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                                   Visibility="{Binding HasDescription, Converter={StaticResource Dyc.BoolToVisibility}}" />
                        <TextBlock Text="{Binding ModifiesText}"
                                   Margin="0,6,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Dyc.WarningBrush}"
                                   Visibility="{Binding HasModifies, Converter={StaticResource Dyc.BoolToVisibility}}" />
                        <TextBlock Text="{Binding MissingText}"
                                   Margin="0,6,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Dyc.ErrorBrush}"
                                   Visibility="{Binding HasMissing, Converter={StaticResource Dyc.BoolToVisibility}}" />

                        <!-- The form: the same inline editors the nodes use. -->
                        <ItemsControl ItemsSource="{Binding Fields}" Margin="0,10,0,0" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="11"
                                                       Margin="0,0,0,2"
                                                       Foreground="{DynamicResource Dyc.TextBrush}"
                                                       Visibility="{Binding Connector.ShowPlainLabel, Converter={StaticResource Dyc.BoolToVisibility}}" />
                                            <TextBlock Text="{Binding Detail}"
                                                       FontSize="10"
                                                       Margin="0,-2,0,2"
                                                       Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                                                       Visibility="{Binding HasDetail, Converter={StaticResource Dyc.BoolToVisibility}}" />
                                            <ContentControl Style="{StaticResource Dyc.EditorHost}" Content="{Binding Connector}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource Dyc.SmallButton}"
                                                VerticalAlignment="Bottom"
                                                Margin="6,0,0,0"
                                                Content="↺"
                                                ToolTip="Back to the value saved in the script"
                                                Command="{Binding ResetCommand}"
                                                Visibility="{Binding IsChanged, Converter={StaticResource Dyc.BoolToVisibility}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="This script asks for nothing — it just runs."
                                   Margin="0,10,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource Dyc.SubtleTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFields}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Buttons -->
                        <DockPanel Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource Dyc.SmallButton}"
                                        Content="Edit"
                                        ToolTip="Open this script in the node editor"
                                        Command="{Binding OpenInEditorCommand}" />
                                <Button Style="{StaticResource Dyc.SmallButton}"
                                        Content="File"
                                        Margin="4,0,0,0"
                                        ToolTip="Show the file in Explorer"
                                        Command="{Binding ShowInExplorerCommand}" />
                            </StackPanel>
                            <Button x:Name="RunButton"
                                    HorizontalAlignment="Left"
                                    Padding="18,5"
                                    Command="{Binding RunCommand}"
                                    ToolTip="Run the script with the values above">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Dyc.ToolButton}">
                                        <Setter Property="Background" Value="{DynamicResource Dyc.AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="▶  Run" />
                            </Button>
                            <Button Style="{StaticResource Dyc.SmallButton}"
                                    Content="Reset"
                                    Margin="6,0,0,0"
                                    HorizontalAlignment="Left"
                                    ToolTip="Put every field back to the value saved in the script"
                                    Command="{Binding ResetCommand}" />
                        </DockPanel>

                        <!-- Progress while it runs -->
                        <TextBlock Text="{Binding RunProgressText}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Dyc.AccentBrush}"
                                   Visibility="{Binding IsRunning, Converter={StaticResource Dyc.BoolToVisibility}}" />

                        <!-- Results -->
                        <StackPanel Visibility="{Binding HasResult, Converter={StaticResource Dyc.BoolToVisibility}}" Margin="0,12,0,0">
                            <Border BorderBrush="{DynamicResource Dyc.PanelBorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,8" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource Dyc.SmallButton}"
                                        Content="Copy"
                                        ToolTip="Copy the results as text"
                                        VerticalAlignment="Top"
                                        Command="{Binding CopyResultsCommand}" />
                                <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ResultSucceeded}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource Dyc.ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Outputs}" Margin="0,8,0,0" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Label}" FontSize="10.5" Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                                            <TextBox Text="{Binding Text, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     TextWrapping="Wrap"
                                                     MaxHeight="220"
                                                     VerticalScrollBarVisibility="Auto"
                                                     FontFamily="Consolas"
                                                     FontSize="11.5"
                                                     Padding="6,4"
                                                     Background="{DynamicResource Dyc.InputBackgroundBrush}"
                                                     BorderBrush="{DynamicResource Dyc.InputBorderBrush}"
                                                     Foreground="{DynamicResource Dyc.TextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Problems}" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,4,7,0" VerticalAlignment="Top" Fill="{DynamicResource Dyc.WarningBrush}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Dyc.TextBrush}">
                                                <Run Text="{Binding Node, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Text, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Dyc.ErrorBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
