<UserControl x:Class="Dyncamelo.UI.Views.PlayerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodify="https://miroiu.github.io/nodify"
             xmlns:vm="clr-namespace:Dyncamelo.UI.ViewModels"
             xmlns:views="clr-namespace:Dyncamelo.UI.Views"
             MinWidth="300"
             MinHeight="280">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Dyncamelo.UI;component/Themes/DyncameloDark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <CollectionViewSource x:Key="ScriptsView" Source="{Binding Scripts}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Folder" />
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>

            <!-- A panel that sets a group of things apart from the pane. -->
            <Style x:Key="Player.Card" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource Dyc.NodeBodyBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Dyc.PanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,12" />
            </Style>

            <!-- The bar that names the open script and unfolds the list of scripts. -->
            <Style x:Key="Player.PickerButton" TargetType="{x:Type Button}">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
                <Setter Property="Background" Value="{DynamicResource Dyc.NodeBodyBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Dyc.InputBorderBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10,8">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsListOpen}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- The one button that does the job: Run. -->
            <Style x:Key="Player.PrimaryButton" TargetType="{x:Type Button}">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Background" Value="{DynamicResource Dyc.AccentBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    MinHeight="30"
                                    Padding="18,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The buttons next to Run. -->
            <Style x:Key="Player.SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Dyc.ToolButton}">
                <Setter Property="BorderBrush" Value="{DynamicResource Dyc.InputBorderBrush}" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <!-- A read-only box for the text a script produced: keeps its columns (no wrapping), scrolls both ways, never cuts text off. -->
            <Style x:Key="Player.OutputBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource Dyc.TextBox}">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="MaxHeight" Value="240" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="8,6" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel x:Name="LayoutRoot" Background="{DynamicResource Dyc.PanelBrush}">

        <!-- ===== Title bar ===== -->
        <Border DockPanel.Dock="Top" Height="34" Background="{DynamicResource Dyc.BrandBrush}">
            <DockPanel Margin="10,0">
                <Border DockPanel.Dock="Left"
                        Width="22" Height="22"
                        CornerRadius="6"
                        Background="{DynamicResource Dyc.LogoChipBrush}"
                        VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Dyncamelo.UI;component/Assets/camel_32.png"
                           Width="18" Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <TextBlock Text="Script Player"
                           Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Dyc.OnBrandBrush}"
                           FontWeight="SemiBold"
                           FontSize="13.5" />
                <TextBlock Text="runs a script without the node editor"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Dyc.OnBrandSubtleBrush}"
                           FontSize="10.5"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ===== Status line ===== -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Dyc.PanelBrush}"
                BorderBrush="{DynamicResource Dyc.PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,4"
                Visibility="{Binding HasStatus, Converter={StaticResource Dyc.BoolToVisibility}}">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                       TextWrapping="Wrap"
                       FontSize="11" />
        </Border>

        <!-- ===== Folders ===== -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource Dyc.PanelBorderBrush}"
                BorderThickness="0,1,0,0">
            <Expander IsExpanded="{Binding IsFoldersOpen, Mode=TwoWay}"
                      Foreground="{DynamicResource Dyc.TextBrush}"
                      Margin="10,5">
                <Expander.Header>
                    <TextBlock Text="Script folders" FontSize="11.5" Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                </Expander.Header>
                <StackPanel Margin="0,6,0,2">
                    <ItemsControl ItemsSource="{Binding Folders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource Dyc.SmallButton}"
                                            Content="✕"
                                            ToolTip="Take this folder off the list (the files stay)"
                                            Command="{Binding RemoveCommand}"
                                            Visibility="{Binding CanRemove, Converter={StaticResource Dyc.BoolToVisibility}}" />
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource Dyc.SmallButton}"
                                            Content="Open"
                                            Margin="0,0,4,0"
                                            ToolTip="Show the folder in Explorer"
                                            Command="{Binding OpenCommand}" />
                                    <TextBlock Text="{Binding Path}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="11"
                                               ToolTip="{Binding Path}"
                                               Foreground="{DynamicResource Dyc.TextBrush}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource Dyc.SmallButton}"
                            Content="Add a folder…"
                            HorizontalAlignment="Left"
                            Margin="0,6,0,0"
                            Command="{Binding AddFolderCommand}" />
                </StackPanel>
            </Expander>
        </Border>

        <!-- ===== While it runs ===== -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Dyc.HoverBrush}"
                BorderBrush="{DynamicResource Dyc.PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,6"
                Visibility="{Binding IsRunning, Converter={StaticResource Dyc.BoolToVisibility}}">
            <TextBlock Text="{Binding RunProgressText}"
                       TextWrapping="Wrap"
                       FontSize="11.5"
                       Foreground="{DynamicResource Dyc.AccentBrush}" />
        </Border>

        <!-- ===== Run bar: always in reach, however long the form is ===== -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Dyc.PanelBrush}"
                BorderBrush="{DynamicResource Dyc.PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,8"
                Visibility="{Binding HasScript, Converter={StaticResource Dyc.BoolToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Player.SecondaryButton}"
                            Content="Edit"
                            ToolTip="Open this script in the node editor"
                            Command="{Binding OpenInEditorCommand}" />
                    <Button Style="{StaticResource Player.SecondaryButton}"
                            Content="File"
                            ToolTip="Show the file in Explorer"
                            Command="{Binding ShowInExplorerCommand}" />
                </StackPanel>
                <Button x:Name="RunButton"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Player.PrimaryButton}"
                        Command="{Binding RunCommand}"
                        ToolTip="Run the script with the values above">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0"
                              VerticalAlignment="Center"
                              Fill="White"
                              Data="{StaticResource Dyc.Icon.Run}" />
                        <TextBlock Text="Run" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource Player.SecondaryButton}"
                        Content="Reset"
                        HorizontalAlignment="Left"
                        ToolTip="Put every field back to the value saved in the script"
                        Command="{Binding ResetCommand}" />
            </DockPanel>
        </Border>

        <!-- ===== The script bar and the list it unfolds ===== -->
        <StackPanel DockPanel.Dock="Top" Margin="10,10,10,0">
            <Button Style="{StaticResource Player.PickerButton}"
                    Command="{Binding ToggleListCommand}"
                    ToolTip="Choose a script">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Dyc.HoverBrush}">
                        <Path Width="15" Height="15" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{DynamicResource Dyc.AccentBrush}"
                              Data="{StaticResource Dyc.Icon.Cat.File}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PickerTitle}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Dyc.TextBrush}" />
                        <TextBlock Text="{Binding PickerSubtitle}"
                                   FontSize="10.5"
                                   Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                    </StackPanel>
                    <Path Grid.Column="2"
                          Width="12" Height="7"
                          VerticalAlignment="Center"
                          Data="M1,1 L6,6 L11,1"
                          Stroke="{DynamicResource Dyc.SubtleTextBrush}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.Style>
                            <Style TargetType="{x:Type Path}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsListOpen}" Value="True">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="180" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
            </Button>

            <Border Style="{StaticResource Player.Card}"
                    Margin="0,6,0,0"
                    Padding="8"
                    Visibility="{Binding IsListOpen, Converter={StaticResource Dyc.BoolToVisibility}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource Dyc.IconButton}"
                                Width="30" Height="30"
                                Margin="6,0,0,0"
                                ToolTip="Look for scripts again"
                                Command="{Binding RefreshCommand}">
                            <TextBlock Text="↻" FontSize="14" />
                        </Button>
                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource Dyc.TextBox}"
                                     Height="30"
                                     FontSize="12"
                                     Padding="30,0,8,0"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Filter the scripts by name or folder. Down moves into the list, Enter chooses."
                                     PreviewKeyDown="OnSearchBoxKeyDown" />
                            <Path Width="13" Height="13" Stretch="Uniform"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Margin="10,0,0,0"
                                  IsHitTestVisible="False"
                                  Fill="{DynamicResource Dyc.SubtleTextBrush}"
                                  Data="{StaticResource Dyc.Icon.Search}" />
                            <TextBlock Text="Search scripts"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="31,0,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource Dyc.SubtleTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>

                    <TextBlock Text="{Binding EmptyListText}"
                               Margin="4,6"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                               Visibility="{Binding IsListEmpty, Converter={StaticResource Dyc.BoolToVisibility}}" />

                    <ListBox x:Name="ScriptList"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="300"
                             Foreground="{DynamicResource Dyc.TextBrush}"
                             ItemsSource="{Binding Source={StaticResource ScriptsView}}"
                             SelectedItem="{Binding SelectedScript, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewKeyDown="OnScriptListKeyDown"
                             PreviewMouseLeftButtonUp="OnScriptListMouseUp">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   Margin="4,8,0,3"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="Chrome"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="2,0,0,0"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- ===== The selected script ===== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10,12,10,14">

                <TextBlock Text="Choose a script above to see what it asks for, then press Run."
                           Margin="4,18,4,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Dyc.SubtleTextBrush}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasScript}" Value="False" />
                                        <Condition Binding="{Binding HasLoadError}" Value="False" />
                                        <Condition Binding="{Binding IsListEmpty}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Style="{StaticResource Player.Card}"
                        BorderBrush="{DynamicResource Dyc.ErrorBrush}"
                        Visibility="{Binding HasLoadError, Converter={StaticResource Dyc.BoolToVisibility}}">
                    <TextBlock Text="{Binding LoadError}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Dyc.ErrorBrush}" />
                </Border>

                <StackPanel Visibility="{Binding HasScript, Converter={StaticResource Dyc.BoolToVisibility}}">

                    <TextBlock Text="{Binding Description}"
                               Margin="4,0,4,12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                               Visibility="{Binding HasDescription, Converter={StaticResource Dyc.BoolToVisibility}}" />

                    <!-- Notes about the script that matter before it is run. -->
                    <Border Background="{DynamicResource Dyc.HoverBrush}"
                            BorderBrush="{DynamicResource Dyc.WarningBrush}"
                            BorderThickness="3,0,0,0"
                            CornerRadius="4"
                            Padding="10,7"
                            Margin="0,0,0,10"
                            Visibility="{Binding HasModifies, Converter={StaticResource Dyc.BoolToVisibility}}">
                        <TextBlock Text="{Binding ModifiesText}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Dyc.TextBrush}" />
                    </Border>
                    <Border Background="{DynamicResource Dyc.HoverBrush}"
                            BorderBrush="{DynamicResource Dyc.ErrorBrush}"
                            BorderThickness="3,0,0,0"
                            CornerRadius="4"
                            Padding="10,7"
                            Margin="0,0,0,10"
                            Visibility="{Binding HasMissing, Converter={StaticResource Dyc.BoolToVisibility}}">
                        <TextBlock Text="{Binding MissingText}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Dyc.TextBrush}" />
                    </Border>

                    <!-- The form: the same inline editors the nodes use, in roomier versions. -->
                    <Border Style="{StaticResource Player.Card}">
                        <StackPanel>
                            <TextBlock Text="Inputs"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"
                                       Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                                       Visibility="{Binding HasFields, Converter={StaticResource Dyc.BoolToVisibility}}" />

                            <ItemsControl ItemsSource="{Binding Fields}" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding Connector.ShowPlainLabel, Converter={StaticResource Dyc.BoolToVisibility}}">
                                                    <TextBlock Text="{Binding Label}"
                                                               FontSize="12"
                                                               Margin="0,0,0,5"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Dyc.TextBrush}" />
                                                    <Ellipse Width="6" Height="6" Margin="6,-3,0,0"
                                                             Fill="{DynamicResource Dyc.AccentBrush}"
                                                             ToolTip="Changed from the value saved in the script"
                                                             Visibility="{Binding IsChanged, Converter={StaticResource Dyc.BoolToVisibility}}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="10.5"
                                                           Margin="0,-3,0,5"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                                                           Visibility="{Binding HasDetail, Converter={StaticResource Dyc.BoolToVisibility}}" />
                                            </StackPanel>

                                            <!-- Where the editor and the reset button sit depends on the kind of field: an on/off switch shares the
                                                 label's row; every other field has its own row under the label. -->
                                            <ContentControl Content="{Binding Connector}">
                                                <ContentControl.Style>
                                                    <Style TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Dyc.PlayerEditorHost}">
                                                        <Setter Property="Grid.Row" Value="1" />
                                                        <Setter Property="Grid.Column" Value="0" />
                                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Connector.EditorKind}" Value="Toggle">
                                                                <Setter Property="Grid.Row" Value="0" />
                                                                <Setter Property="Grid.Column" Value="1" />
                                                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                                <Setter Property="Margin" Value="12,0,0,0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <Button Grid.Column="2"
                                                    Width="28" Height="28"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Content="↺"
                                                    ToolTip="Back to the value saved in the script"
                                                    Command="{Binding ResetCommand}"
                                                    Visibility="{Binding IsChanged, Converter={StaticResource Dyc.BoolToVisibility}}">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Dyc.IconButton}">
                                                        <Setter Property="Grid.Row" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Connector.EditorKind}" Value="Toggle">
                                                                <Setter Property="Grid.Row" Value="0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="This script asks for nothing — it just runs."
                                       FontSize="12"
                                       Foreground="{DynamicResource Dyc.SubtleTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFields}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Results -->
                    <Border Style="{StaticResource Player.Card}"
                            Margin="0,14,0,0"
                            Visibility="{Binding HasResult, Converter={StaticResource Dyc.BoolToVisibility}}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource Dyc.SmallButton}"
                                        Content="Copy"
                                        ToolTip="Copy the results as text"
                                        VerticalAlignment="Center"
                                        Command="{Binding CopyResultsCommand}" />
                                <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,1,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Fill" Value="{DynamicResource Dyc.FnCreateBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ResultSucceeded}" Value="False">
                                                    <Setter Property="Fill" Value="{DynamicResource Dyc.ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ResultSucceeded}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource Dyc.ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding Outputs}" Margin="0,10,0,0" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="11"
                                                       Margin="0,0,0,4"
                                                       Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                                            <TextBox Style="{StaticResource Player.OutputBox}"
                                                     Text="{Binding Text, Mode=OneWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Problems}" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,4,8,0" VerticalAlignment="Top" Fill="{DynamicResource Dyc.WarningBrush}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Dyc.TextBrush}">
                                                <Run Text="{Binding Node, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Text, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Dyc.ErrorBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
