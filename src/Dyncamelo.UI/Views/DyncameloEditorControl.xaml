<UserControl x:Class="Dyncamelo.UI.Views.DyncameloEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodify="https://miroiu.github.io/nodify"
             xmlns:vm="clr-namespace:Dyncamelo.UI.ViewModels"
             MinWidth="400"
             MinHeight="300">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Dyncamelo.UI;component/Themes/DyncameloDark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel x:Name="LayoutRoot" Background="{DynamicResource Dyc.PanelBrush}">

        <!-- ===== Brand bar (BIMCamel identity) — the blue gradient header carries
             the logo in a black chip so its baked-in black background reads as an
             intentional rounded badge, matching the BIMCamel exporter's title bar. -->
        <Border DockPanel.Dock="Top" Height="38" Background="{DynamicResource Dyc.BrandBrush}">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="26" Height="26"
                        CornerRadius="7"
                        Background="{DynamicResource Dyc.LogoChipBrush}"
                        VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Dyncamelo.UI;component/Assets/camel_32.png"
                           Width="22" Height="22"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                    <TextBlock Text="Dyncamelo"
                               Foreground="{DynamicResource Dyc.OnBrandBrush}"
                               FontWeight="SemiBold"
                               FontSize="13.5" />
                    <TextBlock Text="by BIMCamel"
                               Foreground="{DynamicResource Dyc.OnBrandSubtleBrush}"
                               FontSize="9.5"
                               Margin="0,-1,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Dyc.OnBrandSubtleBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="260"
                           Text="{Binding Title}" />
            </Grid>
        </Border>

        <!-- ===== Command bar: the menus (generated from CommandCatalog by EditorMenuBuilder)
             on the left, the few actions worth a button on the right. Everything else lives in
             the menus only, so nothing is offered twice. ===== -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Dyc.PanelBrush}"
                BorderBrush="{DynamicResource Dyc.PanelBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="4,2">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource Dyc.ToolButton}" ToolTip="{Binding UndoTooltip}" Command="{Binding UndoCommand}">
                        <Path Style="{StaticResource Dyc.ToolIcon}" Margin="0" Data="{StaticResource Dyc.Icon.Undo}" />
                    </Button>
                    <Button Style="{StaticResource Dyc.ToolButton}" ToolTip="{Binding RedoTooltip}" Command="{Binding RedoCommand}">
                        <Path Style="{StaticResource Dyc.ToolIcon}" Margin="0" Data="{StaticResource Dyc.Icon.Redo}" />
                    </Button>

                    <Border Width="1" Margin="6,2" Background="{DynamicResource Dyc.PanelBorderBrush}" />

                    <Button Style="{StaticResource Dyc.ToolButton}" ToolTip="{Binding RunTooltip}" Command="{Binding RunCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Dyc.ToolIcon}" Data="{StaticResource Dyc.Icon.Run}" Fill="{DynamicResource Dyc.AccentBrush}" />
                            <TextBlock Text="Run" />
                        </StackPanel>
                    </Button>
                    <ToggleButton Style="{StaticResource Dyc.ToolToggle}"
                                  ToolTip="Re-run automatically after every change"
                                  IsChecked="{Binding IsAutoRun}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Dyc.ToolIcon}" Data="{StaticResource Dyc.Icon.Auto}" />
                            <TextBlock Text="Auto" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource Dyc.ToolToggle}"
                                  ToolTip="Show a value preview bubble under each node after a run"
                                  IsChecked="{Binding ShowNodePreviews}">
                        <Path Style="{StaticResource Dyc.ToolIcon}" Margin="0" Data="{StaticResource Dyc.Icon.Preview}" />
                    </ToggleButton>
                    <ToggleButton x:Name="MinimapButton"
                                  Style="{StaticResource Dyc.ToolToggle}"
                                  ToolTip="{Binding MinimapTooltip}"
                                  Command="{Binding ToggleMinimapCommand}"
                                  IsChecked="{Binding IsMinimapVisible, Mode=OneWay}">
                        <Path Style="{StaticResource Dyc.ToolIcon}" Margin="0" Data="{StaticResource Dyc.Icon.Map}" />
                    </ToggleButton>

                    <Border Width="1" Margin="6,2" Background="{DynamicResource Dyc.PanelBorderBrush}" />

                    <!-- ===== Settings page (sections, search, shortcut rebinding) ===== -->
                    <ToggleButton x:Name="SettingsButton"
                                  Style="{StaticResource Dyc.ToolToggle}"
                                  ToolTip="Settings"
                                  IsChecked="{Binding IsSettingsOpen, Mode=TwoWay}">
                        <Path Style="{StaticResource Dyc.ToolIcon}" Margin="0" Data="{StaticResource Dyc.Icon.Settings}" />
                    </ToggleButton>
                </StackPanel>

                <!-- Not the window's main menu: Alt/F10 must stay with Navisworks (a WPF menu in menu mode
                     grabs the keyboard and mouse of the whole host). -->
                <Menu x:Name="HeaderMenu"
                      IsMainMenu="False"
                      Background="Transparent"
                      Foreground="{DynamicResource Dyc.TextBrush}"
                      VerticalAlignment="Center"
                      Padding="0" />
            </DockPanel>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Dyc.PanelBrush}"
                BorderBrush="{DynamicResource Dyc.PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,3">
            <DockPanel x:Name="StatusBar" SizeChanged="OnStatusBarSizeChanged">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Foreground="{DynamicResource Dyc.SubtleTextBrush}" Text="Nodes: " />
                    <TextBlock Foreground="{DynamicResource Dyc.TextBrush}" Text="{Binding NodeCount}" />

                    <!-- Clicking the counts opens the problems list; F8 walks through the problems. -->
                    <Border Background="Transparent"
                            Cursor="Hand"
                            ToolTip="{Binding ProblemsTooltip}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding ToggleProblemsCommand}" />
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="{DynamicResource Dyc.SubtleTextBrush}" Text="   Warnings: " />
                            <TextBlock Foreground="{DynamicResource Dyc.WarningBrush}" Text="{Binding WarningCount}" />
                            <TextBlock Foreground="{DynamicResource Dyc.SubtleTextBrush}" Text="   Errors: " />
                            <TextBlock Foreground="{DynamicResource Dyc.ErrorBrush}" Text="{Binding ErrorCount}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Foreground="{DynamicResource Dyc.SubtleTextBrush}" Text="   Last run: " />
                    <TextBlock Foreground="{DynamicResource Dyc.TextBrush}" Text="{Binding LastRunMilliseconds}" />
                    <TextBlock Foreground="{DynamicResource Dyc.SubtleTextBrush}" Text=" ms" />
                </StackPanel>
                <TextBlock x:Name="HintLabel"
                           DockPanel.Dock="Right"
                           Margin="0,0,18,0"
                           FontStyle="Italic"
                           Opacity="0.8"
                           Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding HintText}" />
                <TextBlock Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding StatusMessage}" />
            </DockPanel>
        </Border>

        <!-- ===== Library + canvas ===== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LibraryColumn" Width="230" MinWidth="150" />
                <ColumnDefinition x:Name="SplitterColumn" Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Library browser -->
            <DockPanel x:Name="LibraryPanel"
                       Grid.Column="0"
                       Background="{DynamicResource Dyc.PanelBrush}"
                       PreviewKeyDown="OnLibraryPanelPreviewKeyDown"
                       IsKeyboardFocusWithinChanged="OnLibraryPanelIsKeyboardFocusWithinChanged">
                <DockPanel.Resources>
                    <!-- One entry row template shared by the category tree and the
                         flat search results (implicit by DataType). -->
                    <DataTemplate DataType="{x:Type vm:LibraryEntryViewModel}">
                        <Grid x:Name="EntryRow"
                              Background="Transparent"
                              ToolTipService.ShowDuration="30000"
                              ToolTipService.InitialShowDelay="1200">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.ToolTip>
                                <ToolTip MaxWidth="380">
                                    <StackPanel Margin="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Category}" Opacity="0.7" Margin="0,1,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Description}"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasDescription, Converter={StaticResource Dyc.BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Signature}"
                                                   Margin="0,6,0,0"
                                                   FontStyle="Italic"
                                                   Opacity="0.85"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasSignature, Converter={StaticResource Dyc.BoolToVisibility}}" />
                                    </StackPanel>
                                </ToolTip>
                            </Grid.ToolTip>
                            <StackPanel Margin="0,1">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{DynamicResource Dyc.TextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Description}"
                                           FontSize="11"
                                           Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="30"
                                           Margin="0,1,0,0"
                                           Visibility="{Binding IsDescriptionVisible, Converter={StaticResource Dyc.BoolToVisibility}}" />
                            </StackPanel>
                            <Button x:Name="StarButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    Margin="6,1,2,0"
                                    Padding="2,0"
                                    Content="☆"
                                    FontSize="13"
                                    Cursor="Hand"
                                    Visibility="Hidden"
                                    Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                                    ToolTip="Add to favourites"
                                    Command="{Binding DataContext.Library.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="EntryRow" Property="IsMouseOver" Value="True">
                                <Setter TargetName="StarButton" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                <Setter TargetName="StarButton" Property="Visibility" Value="Visible" />
                                <Setter TargetName="StarButton" Property="Content" Value="★" />
                                <Setter TargetName="StarButton" Property="Foreground" Value="{DynamicResource Dyc.WarningBrush}" />
                                <Setter TargetName="StarButton" Property="ToolTip" Value="Remove from favourites" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </DockPanel.Resources>
                <!-- Search row: a search-icon field with an inline quick-clear ✕, and
                     compact expand/collapse symbol buttons sitting right beside it.
                     (The "show descriptions" toggle now lives in the Settings popup.) -->
                <DockPanel DockPanel.Dock="Top" Margin="6,6,6,4">
                    <Button DockPanel.Dock="Left"
                            Style="{StaticResource Dyc.IconButton}"
                            Margin="0,0,4,0"
                            ToolTip="Hide the node library (View ▸ Node Library Panel)"
                            Command="{Binding ToggleLibraryCommand}">
                        <Path Width="14" Height="14" Stretch="Uniform"
                              Fill="{DynamicResource Dyc.SubtleTextBrush}"
                              Data="{StaticResource Dyc.Icon.ChevronLeft}" />
                    </Button>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource Dyc.IconButton}"
                            Margin="4,0,0,0"
                            ToolTip="Collapse all categories"
                            Command="{Binding Library.CollapseAllCommand}">
                        <Path Width="14" Height="14" Stretch="Uniform"
                              Fill="{DynamicResource Dyc.SubtleTextBrush}"
                              Data="{StaticResource Dyc.Icon.ArrowUp}" />
                    </Button>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource Dyc.IconButton}"
                            Margin="4,0,0,0"
                            ToolTip="Expand all categories"
                            Command="{Binding Library.ExpandAllCommand}">
                        <Path Width="14" Height="14" Stretch="Uniform"
                              Fill="{DynamicResource Dyc.SubtleTextBrush}"
                              Data="{StaticResource Dyc.Icon.ArrowDown}" />
                    </Button>
                    <Grid>
                        <TextBox FontSize="13"
                                 Style="{StaticResource Dyc.TextBox}"
                                 Padding="26,3,22,3"
                                 Text="{Binding Library.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search nodes (Esc clears)" />
                        <!-- Search glyph inside the field (transparent to clicks). -->
                        <Path Width="14" Height="14" Stretch="Uniform"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="7,0,0,0"
                              IsHitTestVisible="False"
                              Fill="{DynamicResource Dyc.SubtleTextBrush}"
                              Data="{StaticResource Dyc.Icon.Search}" />
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"
                                Padding="3,0"
                                Content="✕"
                                FontSize="11"
                                Cursor="Hand"
                                Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                                ToolTip="Clear search"
                                Command="{Binding Library.ClearSearchCommand}"
                                Visibility="{Binding Library.HasSearchText, Converter={StaticResource Dyc.BoolToVisibility}}">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </DockPanel>
                <Grid>
                    <TreeView x:Name="LibraryTree"
                              Margin="2,0,2,2"
                              Background="Transparent"
                              BorderThickness="0"
                              FontSize="13"
                              Foreground="{DynamicResource Dyc.TextBrush}"
                              ItemsSource="{Binding Library.RootItems}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              PreviewMouseLeftButtonDown="OnLibraryMouseDown"
                              PreviewMouseMove="OnLibraryMouseMove"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.Style>
                            <Style TargetType="{x:Type TreeView}">
                                <Style.Triggers>
                                    <!-- While searching, the flat result list replaces the
                                         tree; the tree keeps its expansion state untouched. -->
                                    <DataTrigger Binding="{Binding Library.IsSearching}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.Style>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
                                <Setter Property="Padding" Value="0,2" />
                                <EventSetter Event="MouseDoubleClick" Handler="OnLibraryItemDoubleClick" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <!-- Selection colors for the default TreeViewItem template. Their
                                 Color is bound to the theme brushes so the selection highlight
                                 follows a live palette swap (the palette mutates those brushes'
                                 Color in place). -->
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{Binding Color, Source={DynamicResource Dyc.HoverBrush}}" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{Binding Color, Source={DynamicResource Dyc.TextBrush}}" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{Binding Color, Source={DynamicResource Dyc.PanelBorderBrush}}" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{Binding Color, Source={DynamicResource Dyc.TextBrush}}" />
                            <HierarchicalDataTemplate DataType="{x:Type vm:LibraryCategoryViewModel}" ItemsSource="{Binding Children}">
                                <!-- A per-root Material glyph (IconKey, top-level categories only) precedes the name. -->
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Path x:Name="CategoryIcon"
                                          Width="13" Height="13"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0"
                                          Fill="{DynamicResource Dyc.SubtleTextBrush}"
                                          Visibility="Collapsed" />
                                    <TextBlock x:Name="CategoryText"
                                               Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                                </StackPanel>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IconKey}" Value="Annotation">
                                        <Setter TargetName="CategoryIcon" Property="Data" Value="{StaticResource Dyc.Icon.Cat.Annotation}" />
                                        <Setter TargetName="CategoryIcon" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKey}" Value="Color">
                                        <Setter TargetName="CategoryIcon" Property="Data" Value="{StaticResource Dyc.Icon.Cat.Color}" />
                                        <Setter TargetName="CategoryIcon" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKey}" Value="DateTime">
                                        <Setter TargetName="CategoryIcon" Property="Data" Value="{StaticResource Dyc.Icon.Cat.DateTime}" />
                                        <Setter TargetName="CategoryIcon" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKey}" Value="Dictionary">
                                        <Setter TargetName="CategoryIcon" Property="Data" Value="{StaticResource Dyc.Icon.Cat.Dictionary}" />
                                        <Setter TargetName="CategoryIcon" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKey}" Value="Display">
                                        <Setter TargetName="CategoryIcon" Property="Data" Value="{StaticResource Dyc.Icon.Cat.Display}" />
                                        <Setter TargetName="CategoryIcon" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKey}" Value="File">
                                        <Setter TargetName="CategoryIcon" Property="Data" Value="{StaticResource Dyc.Icon.Cat.File}" />
                                        <Setter TargetName="CategoryIcon" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKey}" Value="Geometry">
                                        <Setter TargetName="CategoryIcon" Property="Data" Value="{StaticResource Dyc.Icon.Cat.Geometry}" />
                                        <Setter TargetName="CategoryIcon" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKey}" Value="Input">
                                        <Setter TargetName="CategoryIcon" Property="Data" Value="{StaticResource Dyc.Icon.Cat.Input}" />
                                        <Setter TargetName="CategoryIcon" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKey}" Value="List">
                                        <Setter TargetName="CategoryIcon" Property="Data" Value="{StaticResource Dyc.Icon.Cat.List}" />
                                        <Setter TargetName="CategoryIcon" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKey}" Value="Logic">
                                        <Setter TargetName="CategoryIcon" Property="Data" Value="{StaticResource Dyc.Icon.Cat.Logic}" />
                                        <Setter TargetName="CategoryIcon" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKey}" Value="Math">
                                        <Setter TargetName="CategoryIcon" Property="Data" Value="{StaticResource Dyc.Icon.Cat.Math}" />
                                        <Setter TargetName="CategoryIcon" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKey}" Value="Navisworks">
                                        <Setter TargetName="CategoryIcon" Property="Data" Value="{StaticResource Dyc.Icon.Cat.Navisworks}" />
                                        <Setter TargetName="CategoryIcon" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKey}" Value="String">
                                        <Setter TargetName="CategoryIcon" Property="Data" Value="{StaticResource Dyc.Icon.Cat.String}" />
                                        <Setter TargetName="CategoryIcon" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKey}" Value="Workflow">
                                        <Setter TargetName="CategoryIcon" Property="Data" Value="{StaticResource Dyc.Icon.Cat.Workflow}" />
                                        <Setter TargetName="CategoryIcon" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKey}" Value="Table">
                                        <Setter TargetName="CategoryIcon" Property="Data" Value="{StaticResource Dyc.Icon.Cat.Table}" />
                                        <Setter TargetName="CategoryIcon" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKey}" Value="Favorites">
                                        <Setter TargetName="CategoryIcon" Property="Data" Value="{StaticResource Dyc.Icon.Cat.Favorites}" />
                                        <Setter TargetName="CategoryIcon" Property="Fill" Value="{DynamicResource Dyc.WarningBrush}" />
                                        <Setter TargetName="CategoryIcon" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Name}" Value="★ Favourites">
                                        <Setter TargetName="CategoryText" Property="Foreground" Value="{DynamicResource Dyc.WarningBrush}" />
                                    </DataTrigger>
                                    <!-- Create / Modify / Info leaf-grouping headers: coloured glyph + label. -->
                                    <DataTrigger Binding="{Binding IconKey}" Value="FnCreate">
                                        <Setter TargetName="CategoryIcon" Property="Data" Value="{StaticResource Dyc.Icon.FnCreate}" />
                                        <Setter TargetName="CategoryIcon" Property="Fill" Value="{DynamicResource Dyc.FnCreateBrush}" />
                                        <Setter TargetName="CategoryIcon" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="CategoryText" Property="Foreground" Value="{DynamicResource Dyc.FnCreateBrush}" />
                                        <Setter TargetName="CategoryText" Property="FontSize" Value="11" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKey}" Value="FnModify">
                                        <Setter TargetName="CategoryIcon" Property="Data" Value="{StaticResource Dyc.Icon.FnModify}" />
                                        <Setter TargetName="CategoryIcon" Property="Fill" Value="{DynamicResource Dyc.FnModifyBrush}" />
                                        <Setter TargetName="CategoryIcon" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="CategoryText" Property="Foreground" Value="{DynamicResource Dyc.FnModifyBrush}" />
                                        <Setter TargetName="CategoryText" Property="FontSize" Value="11" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKey}" Value="FnInfo">
                                        <Setter TargetName="CategoryIcon" Property="Data" Value="{StaticResource Dyc.Icon.FnInfo}" />
                                        <Setter TargetName="CategoryIcon" Property="Fill" Value="{DynamicResource Dyc.FnInfoBrush}" />
                                        <Setter TargetName="CategoryIcon" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="CategoryText" Property="Foreground" Value="{DynamicResource Dyc.FnInfoBrush}" />
                                        <Setter TargetName="CategoryText" Property="FontSize" Value="11" />
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                    <!-- Flat search results (Dynamo-style) -->
                    <DockPanel Visibility="{Binding Library.IsSearching, Converter={StaticResource Dyc.BoolToVisibility}}">
                        <TextBlock DockPanel.Dock="Bottom"
                                   Margin="8,4"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                                   Text="{Binding Library.SearchStatusText}"
                                   Visibility="{Binding Library.HasSearchStatus, Converter={StaticResource Dyc.BoolToVisibility}}" />
                        <ListBox x:Name="LibraryResults"
                                 Margin="2,0,2,2"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="13"
                                 Foreground="{DynamicResource Dyc.TextBrush}"
                                 ItemsSource="{Binding Library.SearchResults}"
                                 ItemContainerStyle="{StaticResource Dyc.LibraryResultItemStyle}"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 PreviewMouseLeftButtonDown="OnLibraryMouseDown"
                                 PreviewMouseMove="OnLibraryMouseMove"
                                 MouseDoubleClick="OnLibraryResultsDoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </Grid>
            </DockPanel>

            <GridSplitter x:Name="LibrarySplitter" Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource Dyc.PanelBorderBrush}" />

            <!-- Node canvas -->
            <nodify:NodifyEditor x:Name="Editor"
                                 Grid.Column="2"
                                 ItemsSource="{Binding Items}"
                                 Connections="{Binding Connections}"
                                 SelectedItems="{Binding SelectedItems}"
                                 SelectedConnections="{Binding SelectedConnections}"
                                 PendingConnection="{Binding PendingConnection}"
                                 ViewportZoom="{Binding ViewportZoom, Mode=TwoWay}"
                                 ItemsDragStartedCommand="{Binding ItemsDragStartedCommand}"
                                 ItemsDragCompletedCommand="{Binding ItemsDragCompletedCommand}"
                                 CuttingStartedCommand="{Binding CuttingStartedCommand}"
                                 CuttingCompletedCommand="{Binding CuttingCompletedCommand}"
                                 PendingConnectionTemplate="{StaticResource Dyc.PendingConnectionTemplate}"
                                 ConnectionTemplate="{StaticResource Dyc.ConnectionTemplate}"
                                 DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}"
                                 RemoveConnectionCommand="{Binding RemoveConnectionCommand}"
                                 ItemContainerStyle="{StaticResource Dyc.ItemContainerStyle}"
                                 GridCellSize="{Binding GridCellSize}"
                                 AllowDrop="True"
                                 Drop="OnEditorDrop"
                                 DragOver="OnEditorDragOver"
                                 PreviewMouseDown="OnEditorPreviewMouseDown">

                <nodify:NodifyEditor.Background>
                    <DrawingBrush TileMode="Tile"
                                  ViewportUnits="Absolute"
                                  Viewport="0 0 15 15"
                                  Transform="{Binding ViewportTransform, ElementName=Editor}">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="{DynamicResource Dyc.CanvasBrush}">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0 0 15 15" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="{DynamicResource Dyc.GridLineBrush}" Thickness="0.6" />
                                    </GeometryDrawing.Pen>
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="0,0" EndPoint="15,0" />
                                            <LineGeometry StartPoint="0,0" EndPoint="0,15" />
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </nodify:NodifyEditor.Background>

                <nodify:NodifyEditor.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Add Note Here"
                                  Command="{Binding PlacementTarget.DataContext.AddNoteCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                  CommandParameter="{Binding PlacementTarget.MouseLocation, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <Separator />
                        <MenuItem Header="Copy"
                                  Tag="edit.copy"
                                  InputGestureText="Ctrl+C"
                                  Command="{Binding PlacementTarget.DataContext.CopySelectionCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <MenuItem Header="Paste"
                                  Tag="edit.paste"
                                  InputGestureText="Ctrl+V"
                                  Command="{Binding PlacementTarget.DataContext.PasteCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <MenuItem Header="Duplicate"
                                  Tag="edit.duplicate"
                                  InputGestureText="Ctrl+D"
                                  Command="{Binding PlacementTarget.DataContext.DuplicateSelectionCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <MenuItem Header="Group Selection"
                                  Tag="graph.group"
                                  InputGestureText="Ctrl+G"
                                  Command="{Binding PlacementTarget.DataContext.GroupSelectionCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <MenuItem Header="Arrange Selection"
                                  Tag="graph.arrange"
                                  InputGestureText="Ctrl+L"
                                  Command="{Binding PlacementTarget.DataContext.ArrangeSelectionCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <Separator />
                        <MenuItem Header="Run"
                                  Command="{Binding PlacementTarget.DataContext.RunCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <MenuItem Header="Fit to Screen"
                                  Command="{x:Static nodify:EditorCommands.FitToScreen}"
                                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                    </ContextMenu>
                </nodify:NodifyEditor.ContextMenu>
            </nodify:NodifyEditor>

            <!-- Brings the library back when it is hidden (also View ▸ Node Library Panel, Ctrl+B). -->
            <Button Grid.Column="2"
                    Panel.ZIndex="850"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="0,10,0,0"
                    Width="16"
                    Height="46"
                    Style="{StaticResource Dyc.IconButton}"
                    ToolTip="Show the node library (Ctrl+B)"
                    Command="{Binding ToggleLibraryCommand}"
                    Visibility="{Binding IsLibraryHidden, Converter={StaticResource Dyc.BoolToVisibility}}">
                <Path Width="12" Height="12" Stretch="Uniform"
                      Fill="{DynamicResource Dyc.SubtleTextBrush}"
                      Data="{StaticResource Dyc.Icon.ChevronRight}" />
            </Button>

            <!-- Where you are while a node group is open: Graph > Group > Inner, each step a way back; Shift+Tab closes the group. -->
            <Border Grid.Column="2"
                    Panel.ZIndex="860"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="26,10,0,0"
                    Padding="6,3"
                    CornerRadius="6"
                    BorderThickness="1"
                    Background="{DynamicResource Dyc.OverlayBrush}"
                    BorderBrush="{DynamicResource Dyc.PanelBorderBrush}"
                    Visibility="{Binding IsInsideGroup, Converter={StaticResource Dyc.BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding Breadcrumb}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="Step"
                                            Style="{StaticResource Dyc.SmallButton}"
                                            Content="{Binding Title}"
                                            Command="{Binding NavigateCommand}"
                                            ToolTip="Go back to this level" />
                                    <TextBlock x:Name="Arrow"
                                               Text="▸"
                                               Margin="4,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="Step" Property="FontWeight" Value="Bold" />
                                        <Setter TargetName="Step" Property="ToolTip" Value="The node group you are editing" />
                                        <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource Dyc.SmallButton}"
                            Margin="8,0,0,0"
                            Content="Close group"
                            ToolTip="Close this node group and go back (Shift+Tab)"
                            Command="{Binding ExitGroupCommand}" />
                </StackPanel>
            </Border>

            <!-- Minimap (Ctrl+M): the whole graph at a glance; drag the frame to pan, wheel to zoom.
                 Automatic from 40 nodes, or on/off in Settings and the View menu. -->
            <nodify:Minimap x:Name="MiniMap"
                            Grid.Column="2"
                            Panel.ZIndex="800"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Width="220"
                            Height="150"
                            Margin="0,0,14,14"
                            ItemsSource="{Binding Items}"
                            ViewportLocation="{Binding ViewportLocation, ElementName=Editor, Mode=TwoWay}"
                            ViewportSize="{Binding ViewportSize, ElementName=Editor, Mode=OneWay}"
                            Extent="{Binding ItemsExtent, ElementName=Editor, Mode=OneWay}"
                            Background="{DynamicResource Dyc.MinimapBrush}"
                            BorderBrush="{DynamicResource Dyc.PanelBorderBrush}"
                            BorderThickness="1"
                            Zoom="OnMinimapZoom"
                            Visibility="{Binding IsMinimapVisible, Converter={StaticResource Dyc.BoolToVisibility}}">
                <nodify:Minimap.ViewportStyle>
                    <Style TargetType="{x:Type Rectangle}">
                        <Setter Property="Stroke" Value="{DynamicResource Dyc.AccentBrush}" />
                        <Setter Property="StrokeThickness" Value="2" />
                        <Setter Property="Fill" Value="{DynamicResource Dyc.ViewportFillBrush}" />
                    </Style>
                </nodify:Minimap.ViewportStyle>
                <nodify:Minimap.ItemContainerStyle>
                    <Style TargetType="{x:Type nodify:MinimapItem}">
                        <!-- Each item is drawn as a plain rectangle. Without this the item's content would be the whole
                             node (the implicit NodeViewModel template), doubling every editor on the canvas. -->
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <Border CornerRadius="2" Background="{DynamicResource Dyc.MinimapItemBrush}" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Location" Value="{Binding Location}" />
                        <Setter Property="Width" Value="{Binding Size.Width}" />
                        <Setter Property="Height" Value="{Binding Size.Height}" />
                        <Setter Property="Background" Value="{DynamicResource Dyc.MinimapItemBrush}" />
                    </Style>
                </nodify:Minimap.ItemContainerStyle>
            </nodify:Minimap>

            <!-- Keyboard & mouse help (F1): generated from the command catalogue. -->
            <Border Grid.Column="2"
                    Panel.ZIndex="950"
                    Background="{DynamicResource Dyc.OverlayBrush}"
                    Visibility="{Binding IsHelpOpen, Converter={StaticResource Dyc.BoolToVisibility}}">
                <DockPanel Margin="24,18">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource Dyc.IconButton}"
                                Content="✕"
                                ToolTip="Close (Esc)"
                                Command="{Binding CloseHelpCommand}" />
                        <TextBlock Text="Keyboard and mouse"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Dyc.TextBrush}" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding HelpSections}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="330"
                                            Margin="0,0,14,14"
                                            Padding="12,10"
                                            CornerRadius="6"
                                            Background="{DynamicResource Dyc.PanelBrush}"
                                            BorderBrush="{DynamicResource Dyc.PanelBorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,6"
                                                       Foreground="{DynamicResource Dyc.AccentBrush}" />
                                            <ItemsControl ItemsSource="{Binding Lines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Action}"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource Dyc.TextBrush}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Margin="12,0,0,0"
                                                                       MaxWidth="150"
                                                                       TextWrapping="Wrap"
                                                                       TextAlignment="Right"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                                                                       Text="{Binding Keys}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Settings page: sections on the left, generated from SettingsCatalog; the Shortcuts
                 section is the rebinding table (Change, then press the chord). -->
            <Border Grid.Column="2"
                    Panel.ZIndex="940"
                    Background="{DynamicResource Dyc.OverlayBrush}"
                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource Dyc.BoolToVisibility}}">
                <DockPanel Margin="24,18">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource Dyc.IconButton}"
                                Content="✕"
                                ToolTip="Close (Esc)"
                                Command="{Binding CloseSettingsCommand}" />
                        <TextBox DockPanel.Dock="Right"
                                 Width="240"
                                 Margin="0,0,12,0"
                                 Style="{StaticResource Dyc.TextBox}"
                                 ToolTip="Search the settings"
                                 Text="{Binding SettingsFilter, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Settings"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Dyc.TextBrush}" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ListBox Style="{StaticResource Dyc.NavListBox}"
                                 VerticalAlignment="Top"
                                 ItemsSource="{Binding SettingsSectionNames}"
                                 SelectedItem="{Binding SettingsSection, Mode=TwoWay}" />
                        <ScrollViewer Grid.Column="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="8,0,16,0">
                                <ItemsControl ItemsSource="{Binding VisibleSettings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="190" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Dyc.TextBrush}" />
                                                    <TextBlock Text="{Binding Description}"
                                                               Margin="0,2,0,0"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Top"
                                                          Style="{StaticResource Dyc.NodeCheckBox}"
                                                          IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                          Visibility="{Binding IsToggle, Converter={StaticResource Dyc.BoolToVisibility}}" />
                                                <ComboBox Grid.Column="1"
                                                          VerticalAlignment="Top"
                                                          Height="22"
                                                          Style="{StaticResource Dyc.ComboBox}"
                                                          ItemsSource="{Binding OptionLabels}"
                                                          SelectedItem="{Binding SelectedLabel, Mode=TwoWay}"
                                                          Visibility="{Binding IsChoice, Converter={StaticResource Dyc.BoolToVisibility}}" />
                                                <Button Grid.Column="2"
                                                        VerticalAlignment="Top"
                                                        Style="{StaticResource Dyc.IconButton}"
                                                        Content="↺"
                                                        ToolTip="Back to the default"
                                                        Command="{Binding ResetCommand}"
                                                        Visibility="{Binding IsModified, Converter={StaticResource Dyc.BoolToVisibility}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Appearance: the colour palette -->
                                <StackPanel Visibility="{Binding ShowPaletteChoices, Converter={StaticResource Dyc.BoolToVisibility}}">
                                    <TextBlock Text="Colour palette"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Dyc.TextBrush}" />
                                    <TextBlock Text="The colours of the whole editor."
                                               Margin="0,2,0,6"
                                               FontSize="11"
                                               Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                                    <ItemsControl ItemsSource="{Binding Palettes}" Width="300" HorizontalAlignment="Left">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource Dyc.SettingsChoice}"
                                                        Command="{Binding DataContext.SelectPaletteCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="12" Height="12" CornerRadius="2" Margin="0,0,8,0"
                                                                Background="{Binding Swatch}"
                                                                BorderBrush="{DynamicResource Dyc.PanelBorderBrush}"
                                                                BorderThickness="1" />
                                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Shortcuts: rebinding table -->
                                <StackPanel Visibility="{Binding ShowShortcutTable, Converter={StaticResource Dyc.BoolToVisibility}}">
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource Dyc.SmallButton}"
                                                Content="Reset all shortcuts"
                                                Command="{Binding ResetAllShortcutsCommand}" />
                                        <TextBox Style="{StaticResource Dyc.TextBox}"
                                                 Margin="0,0,12,0"
                                                 ToolTip="Search commands and shortcuts"
                                                 Text="{Binding ShortcutFilter, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <TextBlock Margin="0,0,0,10"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                                               Text="Press Change, then the keys you want. Esc cancels, Backspace removes the shortcut. Every command is listed, including those without one." />
                                    <ItemsControl ItemsSource="{Binding ShortcutRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="0,4" BorderBrush="{DynamicResource Dyc.PanelBorderBrush}" BorderThickness="0,0,0,1">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="190" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Category}"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Title}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource Dyc.TextBrush}" />
                                                            <Border Grid.Column="2"
                                                                    Margin="8,0"
                                                                    Padding="8,2"
                                                                    CornerRadius="3"
                                                                    BorderThickness="1"
                                                                    Background="{DynamicResource Dyc.InputBackgroundBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="{x:Type Border}">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Dyc.InputBorderBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding Display}"
                                                                           FontFamily="Consolas"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource Dyc.TextBrush}" />
                                                            </Border>
                                                            <Button Grid.Column="3"
                                                                    Style="{StaticResource Dyc.SmallButton}"
                                                                    Content="Change"
                                                                    Command="{Binding ChangeCommand}" />
                                                            <Button Grid.Column="4"
                                                                    Margin="4,0,0,0"
                                                                    Style="{StaticResource Dyc.IconButton}"
                                                                    Content="✕"
                                                                    ToolTip="Remove the shortcut"
                                                                    Command="{Binding ClearCommand}" />
                                                            <Button Grid.Column="5"
                                                                    Style="{StaticResource Dyc.IconButton}"
                                                                    Content="↺"
                                                                    ToolTip="Back to the default shortcut"
                                                                    Command="{Binding ResetCommand}"
                                                                    Visibility="{Binding IsCustom, Converter={StaticResource Dyc.BoolToVisibility}}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Message}"
                                                                   Margin="98,3,0,0"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource Dyc.WarningBrush}"
                                                                   Visibility="{Binding HasMessage, Converter={StaticResource Dyc.BoolToVisibility}}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Diagnostics -->
                                <StackPanel Visibility="{Binding ShowDiagnosticsPage, Converter={StaticResource Dyc.BoolToVisibility}}">
                                    <TextBlock Text="Tools"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Dyc.TextBrush}" />
                                    <TextBlock Text="Each of these is also in a menu and the command palette."
                                               Margin="0,2,0,8"
                                               FontSize="11"
                                               Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                                    <WrapPanel>
                                        <Button Style="{StaticResource Dyc.SmallButton}" Margin="0,0,8,8" Content="Performance HUD"
                                                ToolTip="Frame rate, node counts and input state"
                                                Command="{Binding RunCommandIdCommand}" CommandParameter="view.hud" />
                                        <Button Style="{StaticResource Dyc.SmallButton}" Margin="0,0,8,8" Content="Keyboard and mouse help"
                                                Command="{Binding RunCommandIdCommand}" CommandParameter="help.keys" />
                                        <Button Style="{StaticResource Dyc.SmallButton}" Margin="0,0,8,8" Content="Open the user guide"
                                                Command="{Binding RunCommandIdCommand}" CommandParameter="help.guide" />
                                    </WrapPanel>
                                    <TextBlock Text="Reset"
                                               Margin="0,14,0,2"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Dyc.TextBrush}" />
                                    <TextBlock Text="Puts every setting and shortcut back to its default. Favourites and recent files are kept."
                                               Margin="0,0,0,8"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                                    <Button Style="{StaticResource Dyc.SmallButton}"
                                            HorizontalAlignment="Left"
                                            Content="Reset all settings"
                                            Command="{Binding ResetPreferencesCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Command palette (Ctrl+Shift+P): type to find any command or setting, Enter runs it. -->
            <Border Grid.Column="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,42,0,0"
                    Width="480"
                    Background="{DynamicResource Dyc.PanelBrush}"
                    BorderBrush="{DynamicResource Dyc.AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8"
                    Panel.ZIndex="960"
                    Visibility="{Binding IsPaletteOpen, Converter={StaticResource Dyc.BoolToVisibility}}"
                    IsKeyboardFocusWithinChanged="OnPaletteFocusChanged">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <TextBox x:Name="PaletteBox"
                                 FontSize="13"
                                 Style="{StaticResource Dyc.TextBox}"
                                 Padding="26,4,8,4"
                                 Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="OnPaletteBoxKeyDown" />
                        <Path Width="14" Height="14" Stretch="Uniform"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="7,0,0,0"
                              IsHitTestVisible="False"
                              Fill="{DynamicResource Dyc.SubtleTextBrush}"
                              Data="{StaticResource Dyc.Icon.Search}" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="2,5,2,3"
                               FontSize="10"
                               Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                               Text="Type a command, a setting or a node name (@ for nodes only) · ↑↓ choose · Enter runs · Esc closes" />
                    <ListBox x:Name="PaletteList"
                             MaxHeight="360"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="13"
                             Foreground="{DynamicResource Dyc.TextBrush}"
                             ItemsSource="{Binding PaletteResults}"
                             SelectedItem="{Binding PaletteSelected, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             PreviewMouseLeftButtonUp="OnPaletteListClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
                                <Setter Property="Padding" Value="6,3" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="Chrome"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1,0,0,0"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Category}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                                               Text="{Binding Shortcut}"
                                               Visibility="{Binding HasShortcut, Converter={StaticResource Dyc.BoolToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Quick node search (Space over the canvas): type, ↑/↓ to pick,
                 Enter inserts at the spot the cursor was on when it opened. -->
            <Border Grid.Column="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,42,0,0"
                    Width="380"
                    Background="{DynamicResource Dyc.PanelBrush}"
                    BorderBrush="{DynamicResource Dyc.AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8"
                    Panel.ZIndex="900"
                    Visibility="{Binding IsQuickSearchOpen, Converter={StaticResource Dyc.BoolToVisibility}}"
                    IsKeyboardFocusWithinChanged="OnQuickSearchFocusChanged">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <TextBox x:Name="QuickSearchBox"
                                 FontSize="13"
                                 Style="{StaticResource Dyc.TextBox}"
                                 Padding="26,4,8,4"
                                 Text="{Binding QuickSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="OnQuickSearchBoxKeyDown" />
                        <Path Width="14" Height="14" Stretch="Uniform"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="7,0,0,0"
                              IsHitTestVisible="False"
                              Fill="{DynamicResource Dyc.SubtleTextBrush}"
                              Data="{StaticResource Dyc.Icon.Search}" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="2,6,2,0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Dyc.AccentBrush}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding QuickSearchContext}"
                               Visibility="{Binding HasQuickSearchContext, Converter={StaticResource Dyc.BoolToVisibility}}" />
                    <TextBlock DockPanel.Dock="Top"
                               Margin="2,5,2,3"
                               FontSize="10"
                               Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                               Text="{Binding QuickSearchHint}" />
                    <ListBox x:Name="QuickSearchList"
                             MaxHeight="300"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="13"
                             Foreground="{DynamicResource Dyc.TextBrush}"
                             ItemsSource="{Binding QuickSearchResults}"
                             SelectedItem="{Binding QuickSearchSelected, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             PreviewMouseLeftButtonUp="OnQuickSearchListClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
                                <Setter Property="Padding" Value="6,3" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="Chrome"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1,0,0,0"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel ToolTipService.ShowDuration="30000"
                                            ToolTipService.InitialShowDelay="1000">
                                    <StackPanel.ToolTip>
                                        <ToolTip MaxWidth="380">
                                            <StackPanel Margin="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Description}"
                                                           Margin="0,6,0,0"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasDescription, Converter={StaticResource Dyc.BoolToVisibility}}" />
                                                <TextBlock Text="{Binding Signature}"
                                                           Margin="0,6,0,0"
                                                           FontStyle="Italic"
                                                           Opacity="0.85"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasSignature, Converter={StaticResource Dyc.BoolToVisibility}}" />
                                            </StackPanel>
                                        </ToolTip>
                                    </StackPanel.ToolTip>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Category}"
                                               FontSize="10"
                                               Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Side panel (Ctrl+Shift+E problems, Ctrl+Shift+H undo history, Ctrl+Shift+K bookmarks): click a row to go there. -->
            <Border Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,14,14"
                    Width="340"
                    MaxHeight="340"
                    Background="{DynamicResource Dyc.PanelBrush}"
                    BorderBrush="{DynamicResource Dyc.AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8"
                    Panel.ZIndex="940"
                    Visibility="{Binding IsInfoPanelOpen, Converter={StaticResource Dyc.BoolToVisibility}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource Dyc.SmallButton}"
                                Content="✕"
                                ToolTip="Close"
                                Command="{Binding CloseInfoPanelCommand}" />
                        <TextBlock Text="{Binding InfoPanelTitle}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Dyc.TextBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding InfoPanelEmptyText}"
                               Margin="2,4"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                               Visibility="{Binding IsInfoPanelEmpty, Converter={StaticResource Dyc.BoolToVisibility}}" />
                    <ListBox x:Name="InfoPanelList"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="12"
                             Foreground="{DynamicResource Dyc.TextBrush}"
                             ItemsSource="{Binding InfoPanelItems}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="OnInfoPanelItemClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Foreground" Value="{DynamicResource Dyc.TextBrush}" />
                                <Setter Property="Padding" Value="6,3" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="Chrome"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="2,0,0,0"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Dyc.AccentBrush}" />
                                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dyc.HoverBrush}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="Marker"
                                             Width="8" Height="8"
                                             Margin="0,5,8,0"
                                             VerticalAlignment="Top"
                                             Fill="{DynamicResource Dyc.SubtleTextBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="RowTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}"
                                                   FontSize="10.5"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="44"
                                                   Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                                                   Visibility="{Binding HasDetail, Converter={StaticResource Dyc.BoolToVisibility}}" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource Dyc.SmallButton}"
                                            Content="✕"
                                            ToolTip="Remove"
                                            VerticalAlignment="Top"
                                            Command="{Binding RemoveCommand}"
                                            Visibility="{Binding CanRemove, Converter={StaticResource Dyc.BoolToVisibility}}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                                        <Setter TargetName="Marker" Property="Fill" Value="{DynamicResource Dyc.ErrorBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                        <Setter TargetName="Marker" Property="Fill" Value="{DynamicResource Dyc.WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Step">
                                        <Setter TargetName="Marker" Property="Fill" Value="{DynamicResource Dyc.TextBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Bookmark">
                                        <Setter TargetName="Marker" Property="Fill" Value="{DynamicResource Dyc.AccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Future">
                                        <Setter TargetName="Marker" Property="Fill" Value="Transparent" />
                                        <Setter TargetName="Marker" Property="Stroke" Value="{DynamicResource Dyc.SubtleTextBrush}" />
                                        <Setter TargetName="RowTitle" Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Getting started: shown in the middle of an empty canvas, never in the way of clicks. -->
            <StackPanel Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsEmptyCanvasHintVisible, Converter={StaticResource Dyc.BoolToVisibility}}">
                <TextBlock Text="An empty canvas"
                           HorizontalAlignment="Center"
                           FontSize="18"
                           Opacity="0.55"
                           Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                <ItemsControl ItemsSource="{Binding EmptyCanvasHintLines}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       HorizontalAlignment="Center"
                                       Margin="0,2"
                                       FontSize="13"
                                       Opacity="0.55"
                                       Foreground="{DynamicResource Dyc.SubtleTextBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Busy overlay over the canvas. Graph runs are synchronous on the UI
                 thread (Navisworks nodes must run on the host's main thread), so
                 this appears just before the thread blocks to signal "working",
                 alongside the wait cursor set in code-behind. -->
            <Border Grid.Column="2"
                    Background="#66000000"
                    Visibility="{Binding IsRunning, Converter={StaticResource Dyc.BoolToVisibility}}"
                    Panel.ZIndex="1000">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Dyc.PanelBrush}"
                        BorderBrush="{DynamicResource Dyc.AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏳"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding RunProgressText}"
                                       Foreground="{DynamicResource Dyc.TextBrush}"
                                       FontSize="13"
                                       MaxWidth="460"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Press Esc to cancel"
                                       Foreground="{DynamicResource Dyc.SubtleTextBrush}"
                                       FontSize="11"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
